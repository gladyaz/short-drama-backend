PORT=3000
PUBLIC_BASE_URL=http://YOUR_MAC_IP:3000
STORAGE_ROOT=/absolute/path/to/company-video-storage
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# How many reverse proxies sit in front of this process. LEAVE 0 (or unset)
# FOR LOCAL DEVELOPMENT — you run Node directly, so `request.ip` is already
# the real client address. Set it to 1 in a deployment where something else
# terminates TLS in front of you; see .env.production.example for why a wrong
# value silently collapses every per-IP rate limit onto one bucket, and why
# this is a hop COUNT rather than `true`.
TRUST_PROXY_HOPS=0

# PostgreSQL (Phase 8P). For Docker Compose (docker-compose.yml), also set
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB/POSTGRES_PORT below.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/short_drama_dev"
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5433/short_drama_test"
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme-generate-a-real-local-password
POSTGRES_DB=short_drama_dev
POSTGRES_PORT=5433

# Auth (Phase 8, work unit 8-B5). These are PLACEHOLDERS ONLY — never commit
# real secrets. Generate real values locally with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use two DIFFERENT random values for access vs refresh secrets.
JWT_ACCESS_SECRET=changeme-generate-a-real-secret-for-access-tokens
# Phase 12, work unit 12B-B3 update: this SAME secret is now also used to
# HMAC-hash password-reset tokens (PasswordResetToken.tokenHash) before they
# are persisted — a password-reset token and a refresh token are
# cryptographically the same kind of value (an opaque, high-entropy bearer
# secret checked only via a keyed-hash match, never bcrypt), so they
# deliberately share this one hashing key rather than a fourth secret being
# added for it. See README.md's "PasswordResetToken" section for the full
# reasoning.
JWT_REFRESH_SECRET=changeme-generate-a-real-secret-for-refresh-tokens

# Auth audit (Phase 12, work unit 12A-B3). DEDICATED secret used ONLY to
# HMAC-hash client IP addresses before they are written to
# AuthAuditEvent.ipHash — deliberately separate from JWT_ACCESS_SECRET/
# JWT_REFRESH_SECRET above (DECISIONS.md "Phase 12 ... approved..." entry,
# decision 6) so rotating one never affects the other. PLACEHOLDER ONLY —
# generate a real value the same way as the JWT secrets above. Required
# unconditionally; the app fails to boot if unset. Never logged.
#
# Phase 12, work unit 12B-B2 update: this SAME secret is now also used to
# HMAC-hash client IPs before they are written to Session.ipHash (see
# src/auth/auth-crypto.ts) — it already satisfies decision 6's "a dedicated
# secret, distinct from the JWT/refresh-token signing secrets" requirement
# for THAT column too, so this work unit deliberately did not add a second,
# separate env var for it. Not renamed either, to avoid a breaking config
# change for every existing deployment/.env file.
AUTH_AUDIT_IP_HASH_SECRET=changeme-generate-a-real-secret-for-auth-audit-ip-hashing

# Entitlements (Phase 10, work unit 10-B5). Gates the DEV-ONLY
# /dev/entitlements/grant and /dev/entitlements/revoke routes, which stand in
# for a real payment webhook during development/testing. Leave unset or
# "false" everywhere except your own local machine. The app refuses to boot
# if this is "true" unless NODE_ENV is exactly "development" or "test" — a
# deliberate allowlist, not merely "not production" (Phase 12, work unit
# 12D-B2, commit 7cfd411; see README.md's "Entitlements API" section for the
# full history).
DEV_TOOLS_ENABLED=false

# Object storage (Phase 11, work unit 11A-1). Provider-agnostic S3-compatible
# config consumed by StorageService/StorageModule. Cloudflare R2 is the
# approved target provider (region "auto"), but nothing in this
# credential-free slice makes a real network call against these values —
# StorageService is only ever exercised against a MOCKED S3-compatible
# client in tests. PLACEHOLDERS ONLY. Never commit real R2 credentials here;
# real values are a separate, later, human-supervised step (work unit 11A-3).
#
# STORAGE_DRIVER (Phase 11, work unit 11G-3): which backend is active.
# "local" (the default — unset/empty also resolves to "local") preserves
# today's existing behavior byte-for-byte and only requires STORAGE_ROOT
# above. "r2" additionally requires the five REQUIRED credential/endpoint
# names below — OBJECT_STORAGE_ENDPOINT, _REGION, _BUCKET,
# _ACCESS_KEY_ID, _SECRET_ACCESS_KEY (env.validation.ts fails fast, by name
# only, if any is missing) — see docs/r2-readiness.md for the full rollback
# + credential-insertion runbook.
STORAGE_DRIVER=local
OBJECT_STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=changeme-bucket-name
OBJECT_STORAGE_ACCESS_KEY_ID=changeme-r2-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=changeme-r2-secret-access-key

# OBJECT_STORAGE_PUBLIC_BASE_URL (Phase 11, work unit 11H-B1): OPTIONAL, even
# when STORAGE_DRIVER=r2 — env.validation.ts does NOT require it to boot.
# Needed ONLY once a PUBLIC bucket or a custom domain exists to serve public
# object URLs from (StorageService.buildPublicUrl). NOT needed for a PRIVATE
# bucket using presigned PUT/HEAD/GET/DELETE (createPresignedPutUrl/
# createPresignedGetUrl/headObject/objectExists/deleteObject) — none of
# those read this value. The current dev R2 bucket is private, r2.dev is
# disabled, and no custom domain exists, so this is left unset here. If
# buildPublicUrl is ever called without it configured, it throws a clear,
# name-only configuration error instead of assembling a bogus URL. If/when a
# public bucket or custom domain is approved, set it to that base URL, e.g.:
#   OBJECT_STORAGE_PUBLIC_BASE_URL=https://media.example.test
OBJECT_STORAGE_PUBLIC_BASE_URL=

# R2 disposable-object smoke test opt-in (Phase 11, work unit 11G-4). Leave
# unset. Only set RUN_R2_SMOKE=1 together with real OBJECT_STORAGE_* values
# above if you deliberately want to run the real, network-touching
# put/head/delete round-trip in src/storage/storage-r2-smoke.spec.ts against
# an EXISTING bucket — see docs/r2-readiness.md section 3 for the cleanup
# plan. Absent (the default), that test always auto-skips with zero network
# calls.
RUN_R2_SMOKE=

# R2 presigned-MP4 media smoke test opt-in (Phase 11, slice 11K). Leave unset.
# This is a SEPARATE, larger opt-in than RUN_R2_SMOKE above: setting
# RUN_R2_MEDIA_SMOKE=1 runs src/storage/storage-r2-media-smoke.spec.ts, which
# generates a ~2 s SYNTHETIC 64x64 MP4 with FFmpeg (never a company video),
# uploads it through a real presigned PUT URL, HEADs it, downloads it through
# a real presigned GET URL, compares SHA-256 byte-for-byte, DELETEs it, and
# asserts a final HEAD returns not-found. One disposable object under
# `_r2-media-smoke-tests/`. See docs/r2-readiness.md section 5.
#
# PREFER SETTING THIS ON THE COMMAND LINE, NOT HERE:
#   RUN_R2_MEDIA_SMOKE=1 npx jest src/storage/storage-r2-media-smoke.spec.ts
# Jest shares one process.env across every spec in a worker and other specs
# transitively load this file, so an opt-in written into .env is a standing,
# easy-to-forget authorization rather than a deliberate per-run act.
#
# WARNING — SILENT SKIP IS THE FAILURE MODE TO WATCH FOR. The round-trip
# suite needs BOTH RUN_R2_MEDIA_SMOKE=1 AND all five required
# OBJECT_STORAGE_* names above. Setting the flag with an incomplete config
# does NOT quietly skip and report green: an always-running guard test in the
# same file FAILS and names the missing variables (names only, never values).
# Absent (the default), the round-trip suite is describe.skip'd and ZERO
# network calls are made — no S3 client is even constructed.
RUN_R2_MEDIA_SMOKE=

# Ads config (Phase 15A, slice 15A-S1 — control workspace DECISIONS.md,
# "2026-08-03 ... APPROVED ...", commit 0f75033). Backs the public,
# unauthenticated GET /config/ads route consumed by the mobile app's
# interstitial-ad frequency gating at launch. ALL FIVE VARS ARE OPTIONAL —
# env.validation.ts does NOT require any of them to boot. Every value below
# is the frozen-contract DEFAULT; unset/blank/invalid always falls back to
# it (per-field), and each fallback logs a warn naming the variable (never
# its value). These are coarse, non-secret tuning knobs (a flag + four small
# integers), never a credential — safe to return to any anonymous caller.
#
# ADS_INTERSTITIAL_ENABLED: "true" or "false". Unset -> true (silently).
# Anything other than exactly "true"/"false" -> true + a warn.
ADS_INTERSTITIAL_ENABLED=true
# ADS_MIN_VIDEOS_BETWEEN_ADS / ADS_MAX_VIDEOS_BETWEEN_ADS: non-negative
# integers defining the randomized [min, max] threshold re-rolled after each
# shown ad. Non-numeric or negative -> that field's own default + a warn. If
# min > max AFTER parsing, BOTH revert to their defaults + a separate warn.
ADS_MIN_VIDEOS_BETWEEN_ADS=3
ADS_MAX_VIDEOS_BETWEEN_ADS=6
# ADS_MIN_SECONDS_BETWEEN_ADS: cooldown, in seconds, between shown ads. The
# cooldown HOLDS the watched-video counter rather than resetting it.
# Non-numeric or negative -> default + a warn.
ADS_MIN_SECONDS_BETWEEN_ADS=120
# ADS_GRACE_VIDEOS: number of lifetime video watches, from a fresh install,
# that never count toward the ad threshold. Non-numeric or negative ->
# default + a warn.
ADS_GRACE_VIDEOS=5

# Scheduled retention (Phase 13, work unit 13A-B2 — closes the "scheduling
# is Phase 13's" earmark, TASK_QUEUE.md follow-up item 15; control workspace
# DECISIONS.md "Phase 13 opened for a bounded slice (13A)...", 2026-08-04).
# In-app cron scheduler for the existing (Phase 12) RetentionService, which
# is otherwise only invokable by hand via `npm run retention`. All three
# vars are OPTIONAL. See README.md's "Scheduled retention" section for the
# full picture.
#
# RETENTION_SCHEDULE_ENABLED: must be EXACTLY "true" to register the
# scheduled job at all — fail-closed. Unset (the default, as left here),
# "", "1", "TRUE", or "yes" all mean DISABLED: zero cron jobs registered,
# not merely a no-op tick.
RETENTION_SCHEDULE_ENABLED=false
# RETENTION_SCHEDULE_CRON: standard 5-field cron expression for when the job
# fires, only relevant once ENABLED=true. Defaults to "0 3 * * *" (daily at
# 03:00 local server time) when unset/blank. An INVALID expression fails the
# app's boot loudly (it is never silently ignored).
RETENTION_SCHEDULE_CRON=0 3 * * *
# RETENTION_SCHEDULE_COMMIT: must be EXACTLY "true" for the scheduled run to
# actually delete rows. Any other value (including unset, the default) is a
# DRY RUN — a report only, nothing deleted. Even "true" here does NOT bypass
# RetentionService's own existing production guard
# (assertDestructiveRetentionAllowed in retention-env-guard.ts), which still
# fails closed outside NODE_ENV=development/test AND DATABASE_URL matching
# DATABASE_URL_TEST — this var only controls what the SCHEDULER asks for,
# not whether that request is actually honored.
RETENTION_SCHEDULE_COMMIT=false

# Series cover orphan cleanup (slice "SERIES COVER ORPHAN CLEANUP
# LIFECYCLE"). A bounded maintenance sweep that reclaims R2 objects under
# `admin-series/` which no Series row references any more. See
# docs/series-cover-orphan-cleanup.md for the full contract.
#
# There is NO variable here to enable a schedule, and NO variable to change
# the grace window — both are deliberate. The sweep has no cron
# registration at all (unlike RETENTION_SCHEDULE_* above), and its 24-hour
# grace period is a source constant with no env override, so it cannot be
# shortened from outside the source tree.
#
# SERIES_COVER_ORPHAN_APPLY_BUCKET: the ONLY variable this feature reads,
# and it is required exclusively for a DESTRUCTIVE (`--apply`) run. It must
# be set to EXACTLY the same value as OBJECT_STORAGE_BUCKET; unset (the
# default, as left here), empty, or naming a different bucket all refuse the
# run. It is the storage analogue of the retention guard's
# DATABASE_URL/DATABASE_URL_TEST identity check: NODE_ENV=development is the
# normal state of a laptop whose .env legitimately points at a real bucket,
# so NODE_ENV alone must never be sufficient to authorize deletions. Leaving
# it unset costs nothing — the default dry run
# (`npm run maintenance:series-cover-orphans`) needs none of these gates and
# removes nothing.
# SERIES_COVER_ORPHAN_APPLY_BUCKET=

# HLS transcode processing queue foundation (Slice 11N — control workspace
# DECISIONS.md "2026-08-10 — Slice 11N APPROVED..."). TRANSCODE_ENABLED must
# be EXACTLY "true" to activate anything — fail-closed, mirroring the
# RETENTION_SCHEDULE_ENABLED/STORAGE_DRIVER precedent above.
#
# TRANSCODE_ENABLED: unset (the default, as left here), "", "1", "TRUE", or
# any other value all mean DISABLED: zero BullMQ/Redis interaction anywhere
# in the app, POST /admin/media/:id/complete-upload behaves byte-for-byte as
# it did before this slice, and REDIS_URL below is never read, required, or
# connected to. This slice never ships TRANSCODE_ENABLED=true in any real
# environment.
TRANSCODE_ENABLED=false
# REDIS_URL: REQUIRED only when TRANSCODE_ENABLED=true (env.validation.ts
# fails fast, by name/shape only, if TRANSCODE_ENABLED=true and this is
# missing or not a redis://|rediss:// URL — never a network probe, never
# logged). Queue infrastructure only, per the frozen architecture
# (proposals/phase-11-hls-pipeline-proposal.md §8): Redis never carries video
# bytes, presigned URLs, or credentials — only {videoId, processingVersion}
# identifiers on the "media-transcode" queue. PLACEHOLDER ONLY.
REDIS_URL=redis://localhost:6379

# Production transcoding lifecycle (Slice 11P — control workspace
# DECISIONS.md "2026-08-10 — Slice 11P APPROVED..."). All three are OPTIONAL
# even when TRANSCODE_ENABLED=true — each has a documented default in
# src/config/configuration.ts, and env.validation.ts only rejects a
# PRESENT-but-invalid (non-positive-integer) value; none is required to be
# set. See README.md's "Production transcoding lifecycle (Slice 11P)"
# section for the full picture.
#
# TRANSCODE_MAX_ATTEMPTS: retry cap per processing generation before a job
# gives up permanently (failed, MAX_ATTEMPTS_EXCEEDED). Default 3.
TRANSCODE_MAX_ATTEMPTS=3
# TRANSCODE_STALLED_AFTER_MINUTES: how long a row may sit "running" before
# the janitor treats it as stalled and CAS-fails it (STALE). Default 30.
TRANSCODE_STALLED_AFTER_MINUTES=30
# TRANSCODE_CLEANUP_GRACE_MINUTES: how long an orphaned/superseded HLS
# staging prefix must sit untouched before the janitor deletes it.
# Deliberately LONGER than the 30-60 minute playback-token TTL design target
# for the future 11Q gateway, so a generation a viewer may still hold a live
# authorization token for is never deleted out from under them. Default 120.
TRANSCODE_CLEANUP_GRACE_MINUTES=120

# Private HLS Delivery Gateway (Slice 11Q — control workspace DECISIONS.md
# "2026-08-10 — Slice 11Q APPROVED..."). PLACEHOLDERS ONLY. Deliberately NOT
# given real synthetic values on this machine's local .env — TRANSCODE_ENABLED
# stays "false" above, so nothing in this repo ever mints an HLS token today;
# there is nothing to configure yet. Both vars below are validated (name/shape
# only — never a network call) ONLY when TRANSCODE_ENABLED=true, mirroring the
# REDIS_URL conditional-requirement pattern above.
#
# HLS_GATEWAY_BASE_URL: the base URL of the deployed Cloudflare Worker gateway
# (workers/hls-gateway — NOT deployed anywhere by this slice; see that
# package's wrangler.toml.example). VideosService assembles playback URLs as
# `${HLS_GATEWAY_BASE_URL}/t/<token>/<relativePath>` — never a bucket name,
# endpoint host, or R2 credential.
HLS_GATEWAY_BASE_URL=https://your-hls-gateway.example.workers.dev
# HLS_TOKEN_SECRET: DEDICATED HMAC signing secret shared between this backend
# (mint side, src/transcode/hls/hls-playback-token.util.ts) and the Worker
# gateway (verify side, workers/hls-gateway/src/token.ts) — must be the exact
# same value on both sides. Deliberately DISTINCT from JWT_ACCESS_SECRET/
# JWT_REFRESH_SECRET/AUTH_AUDIT_IP_HASH_SECRET above (env.validation.ts fails
# boot if it matches any of them, by name comparison only — values are never
# logged). Generate a real value the same way as the JWT secrets above, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
HLS_TOKEN_SECRET=changeme-generate-a-real-secret-for-hls-playback-tokens
# HLS_TOKEN_TTL_SECONDS: OPTIONAL even when TRANSCODE_ENABLED=true — has a
# documented default (DEFAULT_HLS_TOKEN_TTL_SECONDS, currently 3600s / 60min,
# src/config/configuration.ts). NOT FROZEN (2026-08-10 approval: "design
# target 30-60 min; the final TTL must be validated by real playback QA").
HLS_TOKEN_TTL_SECONDS=3600

# Midtrans Snap payments (work unit "MIDTRANS PAYMENT BACKEND FOUNDATION").
# PLACEHOLDERS ONLY — no real key value may ever be committed to this file.
#
# PAYMENTS_ENABLED: fail-closed feature flag, mirroring TRANSCODE_ENABLED's
# exact-string contract — the payment surface (POST /payments/checkout,
# GET /payments/:orderId, POST /payments/midtrans/notification) only
# activates when this is the literal string "true"; absent, empty, "TRUE",
# "1", or anything else keeps every payment route answering
# 503 PAYMENTS_DISABLED and binds an inert, credential-free provider stub.
# "false" is this repo's only shipped state.
PAYMENTS_ENABLED=false
# MIDTRANS_SERVER_KEY: the Midtrans SERVER key (Dashboard → Settings →
# Access Keys). REQUIRED (name-presence only — the value is never logged)
# when PAYMENTS_ENABLED=true; ignored otherwise. This is the backend-only
# secret used for Snap Basic auth and webhook signature verification — it
# must NEVER be shipped to mobile/web, echoed into a response, or committed.
# Use the SANDBOX server key (SB-Mid-server-...) everywhere except a real
# production deployment.
MIDTRANS_SERVER_KEY=changeme-your-midtrans-SANDBOX-server-key
# MIDTRANS_IS_PRODUCTION: exact-string "true" selects the PRODUCTION
# (real-money) Midtrans endpoints; anything else — including unset — selects
# SANDBOX. Production can never become the default, and env.validation.ts
# additionally refuses to boot with MIDTRANS_IS_PRODUCTION=true unless
# NODE_ENV is exactly "production", so a dev/test machine cannot reach the
# real-money endpoint even by mistake.
MIDTRANS_IS_PRODUCTION=false

# ==========================================================================
# PHASE 10B — PRODUCTION IDENTITY PROVIDERS (Google OIDC + WhatsApp OTP)
# ==========================================================================
# EMAIL/PASSWORD NEEDS NOTHING HERE, deliberately. It is not an optional
# provider behind a flag — it is the always-available baseline, and there is
# no configuration in which an existing account loses the ability to sign in
# the way it always has. Its secrets (JWT_ACCESS_SECRET / JWT_REFRESH_SECRET
# / AUTH_AUDIT_IP_HASH_SECRET, above) are already REQUIRED unconditionally.
#
# The two providers below are flag-gated and OFF by default. With a flag
# off, AuthModule binds an inert provider that holds no configuration and
# can reach no network, and the corresponding routes answer 503.

# --------------------------------------------------------------------------
# GOOGLE
# --------------------------------------------------------------------------
# GOOGLE_AUTH_ENABLED: fail-closed feature flag, identical in shape to
# PAYMENTS_ENABLED / TRANSCODE_ENABLED. Google sign-in activates ONLY when
# this is the literal string "true"; absent, empty, "TRUE", "1" or anything
# else keeps POST /auth/google and the Google link route answering
# 503 GOOGLE_AUTH_DISABLED. "false" is this repo's shipped state.
GOOGLE_AUTH_ENABLED=false
# GOOGLE_OAUTH_CLIENT_IDS: comma-separated allowlist of OAuth 2.0 client ids
# accepted as the `aud` claim of an incoming Google ID token. REQUIRED when
# GOOGLE_AUTH_ENABLED=true (the process refuses to boot without it, because
# a verifier with no configured audience rejects every token); ignored
# otherwise.
#
# List EVERY client that signs users in, because each platform gets its own
# id in Google Cloud Console → APIs & Services → Credentials:
#   <android-client-id>.apps.googleusercontent.com,<ios-client-id>.apps.googleusercontent.com,<web-client-id>.apps.googleusercontent.com
#
# NOT A SECRET: a Google OAuth client id ships inside the mobile app binary
# and is public by design. It is read from the environment so a deployment
# can change it without a code change, not because it needs protecting.
#
# THE OAUTH CLIENT *SECRET* IS DELIBERATELY ABSENT FROM THIS FILE AND FROM
# THE ENTIRE CODEBASE. Verifying an ID token requires only Google's public
# signing keys plus the client id; the client secret belongs to the
# authorization-code exchange, which happens on the CLIENT in this
# architecture. This backend never performs that exchange, so it never needs
# — and must never be given — the secret.
GOOGLE_OAUTH_CLIENT_IDS=

# --------------------------------------------------------------------------
# WHATSAPP OTP
# --------------------------------------------------------------------------
# WHATSAPP_AUTH_ENABLED: fail-closed feature flag, same exact-string shape.
# WhatsApp sign-in activates ONLY when this is the literal string "true";
# otherwise every WhatsApp route answers 503 WHATSAPP_AUTH_DISABLED and an
# inert provider is bound. "false" is this repo's shipped state.
WHATSAPP_AUTH_ENABLED=false
# WHATSAPP_OTP_PROVIDER_DRIVER: which OTP DELIVERY implementation to bind.
# REQUIRED when WHATSAPP_AUTH_ENABLED=true — there is deliberately no
# default, because a backend that accepts OTP requests, answers 202, and
# silently delivers nothing is worse than one that refuses to start.
#
# Two implemented values:
#
#   cloud-api  THE PRODUCTION DRIVER. Meta's WhatsApp Cloud API. Requires the
#              four WHATSAPP_CLOUD_API_* variables below; the boot refuses an
#              incomplete sender. This is what a real deployment sets.
#
#   fake       LOCAL/TEST ONLY. An in-memory provider that SENDS NO MESSAGE
#              AT ALL and retains the plaintext code so automated tests can
#              read it back. env.validation.ts refuses to boot with
#              driver=fake unless NODE_ENV is exactly "development" or "test"
#              (a fail-closed allowlist — an unset/misspelled/differently-
#              cased NODE_ENV counts as unsafe), AuthModule's factory checks
#              the same allowlist again, and LocalFakeWhatsAppOtpProvider's
#              own constructor refuses a third time.
#
# There is NO silent fallback in either direction: enabling WhatsApp auth
# without a valid driver fails the BOOT rather than starting a backend that
# accepts OTP requests, answers 202, and delivers nothing.
#
# Leave UNSET unless you are running the local dev server or the test suite.
WHATSAPP_OTP_PROVIDER_DRIVER=

# --------------------------------------------------------------------------
# WHATSAPP CLOUD API SENDER  (required when WHATSAPP_OTP_PROVIDER_DRIVER=cloud-api)
# --------------------------------------------------------------------------
# All four are obtained from Meta — see docs/WHATSAPP_LOGIN_SETUP.md for the
# step-by-step. NONE of them can be invented: they identify a real WhatsApp
# Business sender and a real approved message template.
#
# WHATSAPP_CLOUD_API_PHONE_NUMBER_ID: the Graph API "Phone number ID" of the
# WhatsApp Business number that sends the code. NOT the phone number itself —
# it is a numeric id shown in the Meta app dashboard under WhatsApp > API
# Setup. Not a secret.
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=

# WHATSAPP_CLOUD_API_ACCESS_TOKEN: SECRET. A System User access token with
# the whatsapp_business_messaging permission on the sending number. Prefer a
# permanent System User token over the 24-hour temporary token the dashboard
# offers, which will silently stop logins when it expires. NEVER commit this,
# never paste it into a ticket, and rotate it if it is ever exposed. The
# backend reads it once at boot and never logs, echoes or returns it.
WHATSAPP_CLOUD_API_ACCESS_TOKEN=

# WHATSAPP_CLOUD_API_TEMPLATE_NAME: the exact name of the APPROVED
# AUTHENTICATION-category template that carries the code. Meta requires an
# authentication template for OTP delivery — a utility or marketing template
# will be rejected at send time (and the backend will answer 503, loudly).
WHATSAPP_CLOUD_API_TEMPLATE_NAME=

# WHATSAPP_CLOUD_API_TEMPLATE_LANGUAGE: the template's language code exactly
# as approved, e.g. "id" for Indonesian or "en_US". A mismatch here is a send
# failure, not a fallback to another language.
WHATSAPP_CLOUD_API_TEMPLATE_LANGUAGE=

# WHATSAPP_CLOUD_API_GRAPH_VERSION: OPTIONAL. Pinned in code to the version
# the client was written against; set this only to move deliberately to a
# newer one. Must look like "v21.0" — it is interpolated into the request URL
# and the boot rejects any other shape.
WHATSAPP_CLOUD_API_GRAPH_VERSION=

# WHATSAPP_CLOUD_API_TEMPLATE_HAS_OTP_BUTTON: OPTIONAL, defaults to true.
# Authentication templates must carry a one-time-password button (copy-code
# or one-tap), and the send payload then carries the code twice — in the body
# and in the button. Set this to "false" ONLY if your template genuinely has
# no button, which also means it is not an authentication template. Note this
# one defaults ON, unlike the fail-closed feature flags above: it describes
# the shape of your template, whose safe default is the shape Meta requires.
WHATSAPP_CLOUD_API_TEMPLATE_HAS_OTP_BUTTON=

# ---------------------------------------------------------------------------
# REWARDS  (work unit "REWARDS BACKEND FOUNDATION")
# ---------------------------------------------------------------------------
# REWARDS_ENABLED: fail-closed feature flag, mirroring PAYMENTS_ENABLED and
# TRANSCODE_ENABLED. While it is false (the shipped default) every
# /rewards/* route answers 503 REWARDS_DISABLED and no reward table is ever
# written. Set it to true for the local Android demo.
#
# There is no external dependency behind this flag — no provider, no
# credentials, no network call. It exists so a deployment turns the points
# economy on deliberately rather than inheriting it, which matters because
# the feature mints spendable balance and grants premium entitlements.
REWARDS_ENABLED=false

# REWARDS_TIMEZONE: the IANA timezone whose CALENDAR DAY defines a "reward
# day" for the daily check-in streak. Optional — defaults to Asia/Jakarta
# (DEFAULT_REWARDS_TIMEZONE in src/config/configuration.ts), the app's
# audience timezone.
#
# This is deliberately a SERVER-side setting with no client input. A
# device-derived day boundary is trivially farmed: move the phone clock
# forward, collect another check-in, repeat. The server owning "today" is
# what makes the streak mean anything.
#
# Validated at BOOT (env.validation.ts): a value Intl cannot resolve as a
# real IANA zone fails startup rather than 500-ing on the first check-in.
# Validated whether or not REWARDS_ENABLED is true, so a typo is found when
# it is introduced, not weeks later when the flag is flipped.
REWARDS_TIMEZONE=Asia/Jakarta

# ---------------------------------------------------------------------------
# SOCIAL FOLLOW MISSIONS  (work unit "REWARDS V1 EARN AND SPEND")
# ---------------------------------------------------------------------------
# The official Red Panda profile each social mission opens. One variable per
# platform, ALL OPTIONAL: a mission whose URL is unset is not served at all
# (no dead tile, no unclaimable button), so the feature can be rolled out one
# platform at a time.
#
# WHAT THESE MISSIONS ACTUALLY VERIFY: NOTHING ABOUT A FOLLOW. No platform
# here exposes a "did user X follow page Y" check for an arbitrary user, so
# the backend records a USER-CONFIRMED EXTERNAL ACTION — it handed the user
# this link, and the user came back and said they did it. The ledger reason is
# EXTERNAL_SOCIAL_ACTION and the API sends verification: "USER_CONFIRMED".
# Nothing in the code or the API claims a verified follow. See
# docs/rewards-api-contract.md section 6.
#
# Each mission pays ONCE PER ACCOUNT, ever, enforced by a server-derived
# ledger key that no client input touches.
#
# VALIDATED AT BOOT, whether or not REWARDS_ENABLED is true. A value that is
# SET but malformed fails startup; the host must be one of the platform's own
# domains, the scheme must be https, and the path must point at a profile
# rather than the platform home page. The host allowlist is the security part:
# these URLs are opened in an external browser on the user's device, so a typo
# must not be able to send users somewhere unintended under Red Panda's
# branding.
#
# `npm run production:preflight` additionally BLOCKS a release whose URL still
# contains a template segment such as "your-handle" — that shape passes every
# boot rule and is still a profile nobody owns.
REWARDS_SOCIAL_INSTAGRAM_URL=
REWARDS_SOCIAL_TIKTOK_URL=
REWARDS_SOCIAL_YOUTUBE_URL=
REWARDS_SOCIAL_FACEBOOK_URL=

# ---------------------------------------------------------------------------
# CONTENT ACCESS MODE  (work unit "V1 FREE ACCESS POLICY")
# ---------------------------------------------------------------------------
# CONTENT_ACCESS_MODE: which content-access policy this deployment enforces.
# Shaped like STORAGE_DRIVER (a NAMED-MODE allowlist), not like the
# TRANSCODE_ENABLED/PAYMENTS_ENABLED exact-string boolean flags — a typo here
# FAILS THE BOOT rather than silently resolving to a mode, because this
# setting has no "safe direction" to fall back in.
#
#   entitlement  (the DEFAULT — unset or empty resolves here)
#                Today's behavior, byte-for-byte. An episode's effective tier
#                is its explicit Video.accessTierOverride when set, otherwise
#                the episodeNumber > FREE_EPISODE_LIMIT (5) derivation, and a
#                premium episode requires an active Entitlement to stream:
#                403 ENTITLEMENT_REQUIRED otherwise.
#
#   free         The Red Panda V1 Google Play policy. The app ships free and
#                ad-monetized with NO purchase flow of any kind, so an episode
#                that resolves premium is not "behind a paywall" — it is
#                permanently unreachable. In this mode EVERY published catalog
#                episode resolves accessTier 'free': the playback gate allows
#                it (guest or signed-in), GET /videos/:id and /videos/feed
#                report accessTier 'free', HLS authorization is returned
#                normally, requiresAuthHeader is false for local-storage rows,
#                and SeriesPublicDto.hasPremiumEpisodes reports false.
#
# PRECEDENCE (deliberate, and the reason for this variable): free mode
# outranks EVERY per-row tier, including an explicit accessTierOverride of
# 'premium'. The override is a statement about the CATALOG; the mode is a
# statement about the DEPLOYMENT. When the deployment cannot sell anything, a
# premium row is content no user can reach by any action available to them.
#
# WHAT IT DOES NOT DO. It grants nobody premium and writes nothing. The
# Entitlement model/service, reward redemption, payments, the
# accessTierOverride column and every value stored in it, the entitlement gate
# itself, and the premium DTO types are all untouched and stay live:
# GET /users/me/entitlement still reports isPremium false for a non-entitled
# viewer in free mode, and a real grant still reads back as premium.
# Ads are entirely independent — GET /config/ads reads only its own ADS_*
# variables and never consults content tier or entitlement.
#
# REVERSIBLE: setting this back to entitlement (or removing it) restores the
# previous enforcement exactly, with no migration and no catalog change,
# because the stored per-row tiers were never modified.
CONTENT_ACCESS_MODE=entitlement
