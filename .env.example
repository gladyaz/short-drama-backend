PORT=3000
PUBLIC_BASE_URL=http://YOUR_MAC_IP:3000
STORAGE_ROOT=/absolute/path/to/company-video-storage
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# PostgreSQL (Phase 8P). For Docker Compose (docker-compose.yml), also set
# POSTGRES_USER/POSTGRES_PASSWORD/POSTGRES_DB/POSTGRES_PORT below.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5433/short_drama_dev"
DATABASE_URL_TEST="postgresql://USER:PASSWORD@localhost:5433/short_drama_test"
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme-generate-a-real-local-password
POSTGRES_DB=short_drama_dev
POSTGRES_PORT=5433

# Auth (Phase 8, work unit 8-B5). These are PLACEHOLDERS ONLY — never commit
# real secrets. Generate real values locally with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use two DIFFERENT random values for access vs refresh secrets.
JWT_ACCESS_SECRET=changeme-generate-a-real-secret-for-access-tokens
# Phase 12, work unit 12B-B3 update: this SAME secret is now also used to
# HMAC-hash password-reset tokens (PasswordResetToken.tokenHash) before they
# are persisted — a password-reset token and a refresh token are
# cryptographically the same kind of value (an opaque, high-entropy bearer
# secret checked only via a keyed-hash match, never bcrypt), so they
# deliberately share this one hashing key rather than a fourth secret being
# added for it. See README.md's "PasswordResetToken" section for the full
# reasoning.
JWT_REFRESH_SECRET=changeme-generate-a-real-secret-for-refresh-tokens

# Auth audit (Phase 12, work unit 12A-B3). DEDICATED secret used ONLY to
# HMAC-hash client IP addresses before they are written to
# AuthAuditEvent.ipHash — deliberately separate from JWT_ACCESS_SECRET/
# JWT_REFRESH_SECRET above (DECISIONS.md "Phase 12 ... approved..." entry,
# decision 6) so rotating one never affects the other. PLACEHOLDER ONLY —
# generate a real value the same way as the JWT secrets above. Required
# unconditionally; the app fails to boot if unset. Never logged.
#
# Phase 12, work unit 12B-B2 update: this SAME secret is now also used to
# HMAC-hash client IPs before they are written to Session.ipHash (see
# src/auth/auth-crypto.ts) — it already satisfies decision 6's "a dedicated
# secret, distinct from the JWT/refresh-token signing secrets" requirement
# for THAT column too, so this work unit deliberately did not add a second,
# separate env var for it. Not renamed either, to avoid a breaking config
# change for every existing deployment/.env file.
AUTH_AUDIT_IP_HASH_SECRET=changeme-generate-a-real-secret-for-auth-audit-ip-hashing

# Entitlements (Phase 10, work unit 10-B5). Gates the DEV-ONLY
# /dev/entitlements/grant and /dev/entitlements/revoke routes, which stand in
# for a real payment webhook during development/testing. Leave unset or
# "false" everywhere except your own local machine. The app refuses to boot
# if this is "true" unless NODE_ENV is exactly "development" or "test" — a
# deliberate allowlist, not merely "not production" (Phase 12, work unit
# 12D-B2, commit 7cfd411; see README.md's "Entitlements API" section for the
# full history).
DEV_TOOLS_ENABLED=false

# Object storage (Phase 11, work unit 11A-1). Provider-agnostic S3-compatible
# config consumed by StorageService/StorageModule. Cloudflare R2 is the
# approved target provider (region "auto"), but nothing in this
# credential-free slice makes a real network call against these values —
# StorageService is only ever exercised against a MOCKED S3-compatible
# client in tests. PLACEHOLDERS ONLY. Never commit real R2 credentials here;
# real values are a separate, later, human-supervised step (work unit 11A-3).
#
# STORAGE_DRIVER (Phase 11, work unit 11G-3): which backend is active.
# "local" (the default — unset/empty also resolves to "local") preserves
# today's existing behavior byte-for-byte and only requires STORAGE_ROOT
# above. "r2" additionally requires the five REQUIRED credential/endpoint
# names below — OBJECT_STORAGE_ENDPOINT, _REGION, _BUCKET,
# _ACCESS_KEY_ID, _SECRET_ACCESS_KEY (env.validation.ts fails fast, by name
# only, if any is missing) — see docs/r2-readiness.md for the full rollback
# + credential-insertion runbook.
STORAGE_DRIVER=local
OBJECT_STORAGE_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=changeme-bucket-name
OBJECT_STORAGE_ACCESS_KEY_ID=changeme-r2-access-key-id
OBJECT_STORAGE_SECRET_ACCESS_KEY=changeme-r2-secret-access-key

# OBJECT_STORAGE_PUBLIC_BASE_URL (Phase 11, work unit 11H-B1): OPTIONAL, even
# when STORAGE_DRIVER=r2 — env.validation.ts does NOT require it to boot.
# Needed ONLY once a PUBLIC bucket or a custom domain exists to serve public
# object URLs from (StorageService.buildPublicUrl). NOT needed for a PRIVATE
# bucket using presigned PUT/HEAD/GET/DELETE (createPresignedPutUrl/
# createPresignedGetUrl/headObject/objectExists/deleteObject) — none of
# those read this value. The current dev R2 bucket is private, r2.dev is
# disabled, and no custom domain exists, so this is left unset here. If
# buildPublicUrl is ever called without it configured, it throws a clear,
# name-only configuration error instead of assembling a bogus URL. If/when a
# public bucket or custom domain is approved, set it to that base URL, e.g.:
#   OBJECT_STORAGE_PUBLIC_BASE_URL=https://media.example.test
OBJECT_STORAGE_PUBLIC_BASE_URL=

# R2 disposable-object smoke test opt-in (Phase 11, work unit 11G-4). Leave
# unset. Only set RUN_R2_SMOKE=1 together with real OBJECT_STORAGE_* values
# above if you deliberately want to run the real, network-touching
# put/head/delete round-trip in src/storage/storage-r2-smoke.spec.ts against
# an EXISTING bucket — see docs/r2-readiness.md section 3 for the cleanup
# plan. Absent (the default), that test always auto-skips with zero network
# calls.
RUN_R2_SMOKE=

# R2 presigned-MP4 media smoke test opt-in (Phase 11, slice 11K). Leave unset.
# This is a SEPARATE, larger opt-in than RUN_R2_SMOKE above: setting
# RUN_R2_MEDIA_SMOKE=1 runs src/storage/storage-r2-media-smoke.spec.ts, which
# generates a ~2 s SYNTHETIC 64x64 MP4 with FFmpeg (never a company video),
# uploads it through a real presigned PUT URL, HEADs it, downloads it through
# a real presigned GET URL, compares SHA-256 byte-for-byte, DELETEs it, and
# asserts a final HEAD returns not-found. One disposable object under
# `_r2-media-smoke-tests/`. See docs/r2-readiness.md section 5.
#
# PREFER SETTING THIS ON THE COMMAND LINE, NOT HERE:
#   RUN_R2_MEDIA_SMOKE=1 npx jest src/storage/storage-r2-media-smoke.spec.ts
# Jest shares one process.env across every spec in a worker and other specs
# transitively load this file, so an opt-in written into .env is a standing,
# easy-to-forget authorization rather than a deliberate per-run act.
#
# WARNING — SILENT SKIP IS THE FAILURE MODE TO WATCH FOR. The round-trip
# suite needs BOTH RUN_R2_MEDIA_SMOKE=1 AND all five required
# OBJECT_STORAGE_* names above. Setting the flag with an incomplete config
# does NOT quietly skip and report green: an always-running guard test in the
# same file FAILS and names the missing variables (names only, never values).
# Absent (the default), the round-trip suite is describe.skip'd and ZERO
# network calls are made — no S3 client is even constructed.
RUN_R2_MEDIA_SMOKE=

# Ads config (Phase 15A, slice 15A-S1 — control workspace DECISIONS.md,
# "2026-08-03 ... APPROVED ...", commit 0f75033). Backs the public,
# unauthenticated GET /config/ads route consumed by the mobile app's
# interstitial-ad frequency gating at launch. ALL FIVE VARS ARE OPTIONAL —
# env.validation.ts does NOT require any of them to boot. Every value below
# is the frozen-contract DEFAULT; unset/blank/invalid always falls back to
# it (per-field), and each fallback logs a warn naming the variable (never
# its value). These are coarse, non-secret tuning knobs (a flag + four small
# integers), never a credential — safe to return to any anonymous caller.
#
# ADS_INTERSTITIAL_ENABLED: "true" or "false". Unset -> true (silently).
# Anything other than exactly "true"/"false" -> true + a warn.
ADS_INTERSTITIAL_ENABLED=true
# ADS_MIN_VIDEOS_BETWEEN_ADS / ADS_MAX_VIDEOS_BETWEEN_ADS: non-negative
# integers defining the randomized [min, max] threshold re-rolled after each
# shown ad. Non-numeric or negative -> that field's own default + a warn. If
# min > max AFTER parsing, BOTH revert to their defaults + a separate warn.
ADS_MIN_VIDEOS_BETWEEN_ADS=3
ADS_MAX_VIDEOS_BETWEEN_ADS=6
# ADS_MIN_SECONDS_BETWEEN_ADS: cooldown, in seconds, between shown ads. The
# cooldown HOLDS the watched-video counter rather than resetting it.
# Non-numeric or negative -> default + a warn.
ADS_MIN_SECONDS_BETWEEN_ADS=120
# ADS_GRACE_VIDEOS: number of lifetime video watches, from a fresh install,
# that never count toward the ad threshold. Non-numeric or negative ->
# default + a warn.
ADS_GRACE_VIDEOS=5

# Scheduled retention (Phase 13, work unit 13A-B2 — closes the "scheduling
# is Phase 13's" earmark, TASK_QUEUE.md follow-up item 15; control workspace
# DECISIONS.md "Phase 13 opened for a bounded slice (13A)...", 2026-08-04).
# In-app cron scheduler for the existing (Phase 12) RetentionService, which
# is otherwise only invokable by hand via `npm run retention`. All three
# vars are OPTIONAL. See README.md's "Scheduled retention" section for the
# full picture.
#
# RETENTION_SCHEDULE_ENABLED: must be EXACTLY "true" to register the
# scheduled job at all — fail-closed. Unset (the default, as left here),
# "", "1", "TRUE", or "yes" all mean DISABLED: zero cron jobs registered,
# not merely a no-op tick.
RETENTION_SCHEDULE_ENABLED=false
# RETENTION_SCHEDULE_CRON: standard 5-field cron expression for when the job
# fires, only relevant once ENABLED=true. Defaults to "0 3 * * *" (daily at
# 03:00 local server time) when unset/blank. An INVALID expression fails the
# app's boot loudly (it is never silently ignored).
RETENTION_SCHEDULE_CRON=0 3 * * *
# RETENTION_SCHEDULE_COMMIT: must be EXACTLY "true" for the scheduled run to
# actually delete rows. Any other value (including unset, the default) is a
# DRY RUN — a report only, nothing deleted. Even "true" here does NOT bypass
# RetentionService's own existing production guard
# (assertDestructiveRetentionAllowed in retention-env-guard.ts), which still
# fails closed outside NODE_ENV=development/test AND DATABASE_URL matching
# DATABASE_URL_TEST — this var only controls what the SCHEDULER asks for,
# not whether that request is actually honored.
RETENTION_SCHEDULE_COMMIT=false

# HLS transcode processing queue foundation (Slice 11N — control workspace
# DECISIONS.md "2026-08-10 — Slice 11N APPROVED..."). TRANSCODE_ENABLED must
# be EXACTLY "true" to activate anything — fail-closed, mirroring the
# RETENTION_SCHEDULE_ENABLED/STORAGE_DRIVER precedent above.
#
# TRANSCODE_ENABLED: unset (the default, as left here), "", "1", "TRUE", or
# any other value all mean DISABLED: zero BullMQ/Redis interaction anywhere
# in the app, POST /admin/media/:id/complete-upload behaves byte-for-byte as
# it did before this slice, and REDIS_URL below is never read, required, or
# connected to. This slice never ships TRANSCODE_ENABLED=true in any real
# environment.
TRANSCODE_ENABLED=false
# REDIS_URL: REQUIRED only when TRANSCODE_ENABLED=true (env.validation.ts
# fails fast, by name/shape only, if TRANSCODE_ENABLED=true and this is
# missing or not a redis://|rediss:// URL — never a network probe, never
# logged). Queue infrastructure only, per the frozen architecture
# (proposals/phase-11-hls-pipeline-proposal.md §8): Redis never carries video
# bytes, presigned URLs, or credentials — only {videoId, processingVersion}
# identifiers on the "media-transcode" queue. PLACEHOLDER ONLY.
REDIS_URL=redis://localhost:6379

# Production transcoding lifecycle (Slice 11P — control workspace
# DECISIONS.md "2026-08-10 — Slice 11P APPROVED..."). All three are OPTIONAL
# even when TRANSCODE_ENABLED=true — each has a documented default in
# src/config/configuration.ts, and env.validation.ts only rejects a
# PRESENT-but-invalid (non-positive-integer) value; none is required to be
# set. See README.md's "Production transcoding lifecycle (Slice 11P)"
# section for the full picture.
#
# TRANSCODE_MAX_ATTEMPTS: retry cap per processing generation before a job
# gives up permanently (failed, MAX_ATTEMPTS_EXCEEDED). Default 3.
TRANSCODE_MAX_ATTEMPTS=3
# TRANSCODE_STALLED_AFTER_MINUTES: how long a row may sit "running" before
# the janitor treats it as stalled and CAS-fails it (STALE). Default 30.
TRANSCODE_STALLED_AFTER_MINUTES=30
# TRANSCODE_CLEANUP_GRACE_MINUTES: how long an orphaned/superseded HLS
# staging prefix must sit untouched before the janitor deletes it.
# Deliberately LONGER than the 30-60 minute playback-token TTL design target
# for the future 11Q gateway, so a generation a viewer may still hold a live
# authorization token for is never deleted out from under them. Default 120.
TRANSCODE_CLEANUP_GRACE_MINUTES=120
