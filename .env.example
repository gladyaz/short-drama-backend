PORT=3000
PUBLIC_BASE_URL=http://YOUR_MAC_IP:3000
STORAGE_ROOT=/absolute/path/to/company-video-storage
CORS_ORIGINS=http://localhost:8081

# SQLite dev database for Prisma (local file, not a secret)
DATABASE_URL="file:./dev.db"

# Auth (Phase 8, work unit 8-B5). These are PLACEHOLDERS ONLY — never commit
# real secrets. Generate real values locally with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use two DIFFERENT random values for access vs refresh secrets.
JWT_ACCESS_SECRET=changeme-generate-a-real-secret-for-access-tokens
JWT_REFRESH_SECRET=changeme-generate-a-real-secret-for-refresh-tokens
