# short-drama-backend — PRODUCTION environment contract.
#
# NAMES AND DOCUMENTATION ONLY. Every value below is supplied by the release
# owner at deploy time and NONE of them belongs in git. This file is safe to
# commit precisely because it contains no value that is a secret.
#
# WHY A SEPARATE FILE FROM .env.example: that one documents LOCAL DEVELOPMENT
# defaults — a LAN base URL over plain HTTP, a Mac filesystem STORAGE_ROOT,
# DEV_TOOLS_ENABLED, the `fake` WhatsApp OTP driver. Several of those values
# make the process REFUSE TO BOOT in production (by design — see the
# fail-closed sections below). Copying the wrong file is how that happens.
#
# The app validates this contract at boot (src/config/env.validation.ts) and
# exits non-zero on a missing or malformed required variable, naming the
# VARIABLE ONLY — never its value. A misconfiguration cannot start and then
# fail quietly at request time.
#
# Verify a candidate configuration with:  npm run build && node dist/main


# ── REQUIRED — the process will not start without every one of these ────────

# Bind port. Managed platforms inject this; read it rather than hardcoding.
PORT=8080

# The PUBLIC HTTPS ORIGIN this API is reachable at, no trailing slash
# (e.g. https://api.example.com). This is NOT cosmetic: it is the origin the
# backend stamps into the `playbackUrl` it returns for every LOCAL-storage
# video row (`GET /videos/:id/playback`). Left at its `http://localhost:3000`
# code default, the mobile app receives a localhost URL and playback fails on
# every device with no error the backend can see.
PUBLIC_BASE_URL=

# Absolute path to the local media directory. REQUIRED AND MUST ALREADY EXIST
# AS A DIRECTORY even when STORAGE_DRIVER=r2 — boot fails otherwise, so on a
# fresh container create it (or point at an existing empty path such as
# /tmp/storage) before first start. It is read for real only by
# `GET /videos/:id/stream`, which serves rows that have a `storageKey` and no
# `objectStorageKey`. See "MEDIA REALITY CHECK" at the bottom of this file —
# on a container this directory is empty and ephemeral, so any row that still
# depends on it is unplayable in production.
STORAGE_ROOT=

# Comma-separated exact browser origins allowed to call this API. EMPTY IS
# SAFE AND IS THE RIGHT ANSWER FOR A MOBILE-ONLY V1: the Android app is not a
# browser, sends no Origin header, and is completely unaffected by CORS. Add
# an origin only for a real web admin dashboard. Never use "*".
CORS_ORIGINS=

# PostgreSQL connection string. Use the platform's INTERNAL/private network
# hostname where one exists, and require TLS on any connection that leaves
# the provider's network (append ?sslmode=require).
DATABASE_URL=

# ── SECRETS — generate independently, never reuse one for another ───────────
#
# Generate each with:  openssl rand -base64 48
# Rotating JWT_ACCESS_SECRET/JWT_REFRESH_SECRET signs every existing session
# out. Rotating AUTH_AUDIT_IP_HASH_SECRET does not sign anyone out, but old
# and new ipHash values stop correlating.

# Signs short-lived access tokens.
JWT_ACCESS_SECRET=

# Signs refresh tokens (which are ALSO hashed at rest in the Session table).
# Must be different from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=

# Dedicated HMAC key for hashing client IPs into Session.ipHash and
# AuthAuditEvent.ipHash. Deliberately distinct from both JWT secrets so
# rotating one never changes the other's blast radius. Required
# unconditionally — auth auditing is on the core login path, not an add-on.
AUTH_AUDIT_IP_HASH_SECRET=

# ── REVERSE PROXY / HTTPS ───────────────────────────────────────────────────

# How many reverse proxies sit in front of this process. SET THIS TO 1 ON ANY
# MANAGED PLATFORM (Fly, Render, Railway, Cloud Run, an ALB, an nginx
# ingress) — i.e. anywhere TLS is terminated for you, which is everywhere a
# public HTTPS origin comes from.
#
# Left at 0 behind a proxy, `request.ip` is the PROXY's address for every
# caller, so every per-IP control in the app collapses onto ONE bucket: the
# 5-logins-per-minute limit becomes 5 logins per minute for the entire user
# base (a self-inflicted outage), and every Session/AuthAuditEvent ipHash
# records the same address.
#
# Set it to the REAL number of proxies. It is a hop count, never `true`:
# trusting the whole X-Forwarded-For chain would let any client prepend a
# forged address and mint unlimited rate-limit identities.
TRUST_PROXY_HOPS=1

# ── MEDIA / OBJECT STORAGE ──────────────────────────────────────────────────

# `local` (default) serves media bytes off STORAGE_ROOT through the Node
# process. `r2` serves them as short-lived presigned GET URLs straight from
# object storage. A public deployment wants `r2`: a container filesystem is
# empty on boot and discarded on every deploy.
STORAGE_DRIVER=r2

# The five OBJECT_STORAGE_* names below are REQUIRED when STORAGE_DRIVER=r2
# and unread when it is `local`. Presence is checked at boot; no network call
# is made and no credential is ever logged.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Only for a PUBLIC bucket or a custom media domain. Leave empty for a
# private bucket served by presigned URLs (the intended posture).
OBJECT_STORAGE_PUBLIC_BASE_URL=

# ── HLS DELIVERY (only if the transcode pipeline is turned on) ──────────────
#
# TRANSCODE_ENABLED=true additionally REQUIRES a reachable Redis (REDIS_URL),
# an ffmpeg/ffprobe binary, and a SEPARATE worker process (`node
# dist/worker/main`) — the API process alone does not transcode. Leave this
# false for V1 unless that whole topology exists.
TRANSCODE_ENABLED=false
REDIS_URL=

# Required when TRANSCODE_ENABLED=true. The deployed HLS gateway Worker's
# public https origin, and the HMAC key it shares with this backend. The
# secret MUST be byte-identical on both sides and MUST differ from all three
# auth secrets above (boot refuses if it matches one).
HLS_GATEWAY_BASE_URL=
HLS_TOKEN_SECRET=
HLS_TOKEN_TTL_SECONDS=3600

# Transcode retry/janitor tuning. All optional with the documented defaults
# shown, all read ONLY when TRANSCODE_ENABLED=true, and all validated at boot
# as positive integers if present (a malformed value fails the boot rather
# than silently reverting to the default). Listed so the contract covers every
# variable the code reads, not only the ones V1 turns on.
TRANSCODE_MAX_ATTEMPTS=3
TRANSCODE_STALLED_AFTER_MINUTES=30
TRANSCODE_CLEANUP_GRACE_MINUTES=120

# ── IDENTITY PROVIDERS ──────────────────────────────────────────────────────

# Google Sign-In. NO CLIENT SECRET IS INVOLVED: the client obtains the ID
# token and this backend only VERIFIES it, against Google's public JWKS.
# GOOGLE_OAUTH_CLIENT_IDS is the audience allowlist and is REQUIRED (at least
# one non-empty entry) when enabled — an empty allowlist would 401 every
# legitimate sign-in. Comma-separated for multiple platforms. It must include
# the WEB client id the mobile app mints its token against, and the client
# must be registered to com.spark.redpanda.
GOOGLE_AUTH_ENABLED=true
GOOGLE_OAUTH_CLIENT_IDS=

# WhatsApp OTP — MUST STAY OFF FOR V1, and BOTH lines must stay as they are.
# The only implemented driver is `fake`, which sends no message and retains
# the plaintext code; boot REFUSES if WHATSAPP_OTP_PROVIDER_DRIVER=fake while
# NODE_ENV is not development/test, and refuses again if WhatsApp auth is
# enabled with no implemented driver. Leaving the driver line EMPTY (not the
# word "fake") is what lets a production process start.
WHATSAPP_AUTH_ENABLED=false
WHATSAPP_OTP_PROVIDER_DRIVER=

# ── REWARDS ─────────────────────────────────────────────────────────────────

# Points ledger, daily check-in and redemption. While false, every
# /rewards/* route answers 503 REWARDS_DISABLED — a deliberate, honest dark
# state, not a broken one.
REWARDS_ENABLED=false

# IANA zone defining the daily check-in boundary. Validated at boot
# UNCONDITIONALLY (even while rewards are dark), because a typo would
# otherwise 500 every rewards request once the flag is flipped.
REWARDS_TIMEZONE=Asia/Jakarta

# ── ADS (public, non-secret tuning for GET /config/ads) ─────────────────────
#
# All optional with documented defaults. Values here are coarse pacing knobs
# read by the mobile interstitial gate; none is a credential. The AdMob app
# id and ad unit id live in the MOBILE build, never here.
ADS_INTERSTITIAL_ENABLED=true
ADS_MIN_VIDEOS_BETWEEN_ADS=3
ADS_MAX_VIDEOS_BETWEEN_ADS=6
ADS_MIN_SECONDS_BETWEEN_ADS=120
ADS_GRACE_VIDEOS=5

# ── PAYMENTS — OFF FOR V1 ───────────────────────────────────────────────────
#
# While PAYMENTS_ENABLED is not the literal string "true", every /payments/*
# route answers 503 PAYMENTS_DISABLED and no Midtrans credential is read or
# required. MIDTRANS_IS_PRODUCTION=true is separately refused at boot unless
# NODE_ENV is exactly "production" — so a real-money endpoint can never be
# reached from a staging process by accident.
PAYMENTS_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── MUST BE SET / MUST STAY UNSET FOR PRODUCTION ────────────────────────────

# Required for the fail-closed guards above to recognise this as production.
NODE_ENV=production

# Opens /dev/entitlements/* AND /dev/admin/* — the latter is SELF-SERVICE
# ADMIN-ROLE GRANT, i.e. privilege escalation. Boot REFUSES when this is true
# unless NODE_ENV is exactly development or test (a fail-closed allowlist, not
# a "!== production" check). Keep it false; it also gates /health/details.
DEV_TOOLS_ENABLED=false

# Retention job scheduler. Leave off unless deliberately operating it; it has
# its own independent environment guard.
RETENTION_SCHEDULE_ENABLED=false
RETENTION_SCHEDULE_CRON=0 3 * * *
RETENTION_SCHEDULE_COMMIT=false

# NEVER SET IN THE RUNNING SERVICE'S ENVIRONMENT: DATABASE_URL_TEST,
# RUN_R2_SMOKE, RUN_R2_MEDIA_SMOKE, RUN_R2_HLS_SMOKE,
# SERIES_COVER_ORPHAN_APPLY_BUCKET, R2_MEDIA_MIGRATION_APPLY_BUCKET.
#
# These belong to the test and maintenance surfaces only. The last two are
# deliberate write-authorization gates for hand-run CLIs (the cover-orphan
# cleanup and the R2 media migration): each must be supplied inline on the
# one command that needs it, e.g.
#
#   R2_MEDIA_MIGRATION_APPLY_BUCKET="$OBJECT_STORAGE_BUCKET" \
#   npm run media:r2-migrate -- --upload
#
# Baking either into the service environment would leave a standing
# authorization to write, which is exactly what the restatement exists to
# prevent. See docs/R2_MEDIA_MIGRATION.md.

# ── MEDIA REALITY CHECK (read before the first deploy) ──────────────────────
#
# Setting STORAGE_DRIVER=r2 does NOT by itself move existing content. A video
# row is served from object storage only if that ROW carries an
# `objectStorageKey` (or a completed `hlsMasterKey`); a row with only a
# `storageKey` is still served off STORAGE_ROOT by the Node process, which on
# a container means an empty directory and a 404.
#
# Audit the target database before trusting playback:
#
#   SELECT count(*) FILTER (WHERE "objectStorageKey" IS NOT NULL) AS on_r2,
#          count(*) FILTER (WHERE "objectStorageKey" IS NULL
#                             AND "hlsMasterKey" IS NULL)        AS local_only
#   FROM "Video" WHERE "lifecycleState" = 'published';
#
# Every `local_only` row must have its media uploaded to the bucket and its
# `objectStorageKey` set before a guest can play it over the public internet.
