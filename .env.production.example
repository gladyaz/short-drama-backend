# short-drama-backend — PRODUCTION environment contract.
#
# NAMES AND DOCUMENTATION ONLY. Every value below is supplied by the release
# owner at deploy time and NONE of them belongs in git. This file is safe to
# commit precisely because it contains no value that is a secret.
#
# WHY A SEPARATE FILE FROM .env.example: that one documents LOCAL DEVELOPMENT
# defaults — a LAN base URL over plain HTTP, a Mac filesystem STORAGE_ROOT,
# DEV_TOOLS_ENABLED, the `fake` WhatsApp OTP driver. Several of those values
# make the process REFUSE TO BOOT in production (by design — see the
# fail-closed sections below). Copying the wrong file is how that happens.
#
# The app validates this contract at boot (src/config/env.validation.ts) and
# exits non-zero on a missing or malformed required variable, naming the
# VARIABLE ONLY — never its value. A misconfiguration cannot start and then
# fail quietly at request time.
#
# Verify a candidate configuration WITHOUT deploying it:
#
#   env $(grep -v '^#' .env.production | xargs) npm run production:preflight
#
# That command is read-only — no connection, no query, no bucket, no write —
# and prints no secret value. It reports PASS/WARNING/BLOCKER and exits
# non-zero on any blocker. See docs/PRODUCTION_HTTPS.md for the full
# topology, HTTPS rules, CORS behaviour and health-check contract.


# ── REQUIRED — the process will not start without every one of these ────────

# Bind port. Managed platforms inject this; read it rather than hardcoding.
PORT=8080

# The PUBLIC HTTPS ORIGIN this API is reachable at, no trailing slash
# (e.g. https://api.example.com). This is NOT cosmetic: it is the origin the
# backend stamps into the `playbackUrl` it returns for every LOCAL-storage
# video row (`GET /videos/:id/playback`). Left at its `http://localhost:3000`
# code default, the mobile app receives a localhost URL and playback fails on
# every device with no error the backend can see.
PUBLIC_BASE_URL=

# Absolute path to the local media directory. REQUIRED AND MUST ALREADY EXIST
# AS A DIRECTORY even when STORAGE_DRIVER=r2 — boot fails otherwise, so on a
# fresh container create it (or point at an existing empty path such as
# /tmp/storage) before first start. It is read for real only by
# `GET /videos/:id/stream`, which serves rows that have a `storageKey` and no
# `objectStorageKey`. See "MEDIA REALITY CHECK" at the bottom of this file —
# on a container this directory is empty and ephemeral, so any row that still
# depends on it is unplayable in production.
STORAGE_ROOT=

# Comma-separated exact browser origins allowed to call this API. EMPTY IS
# SAFE AND IS THE RIGHT ANSWER FOR A MOBILE-ONLY V1: the Android app is not a
# browser, sends no Origin header, and is completely unaffected by CORS. Add
# an origin only for a real web admin dashboard.
#
# The variable must be DECLARED (leave the line below in place) but an empty
# VALUE is valid and means deny-all.
#
# In production each entry must be a bare https origin — `https://host` or
# `https://host:port`, with NO path, query, fragment or TRAILING SLASH. A
# browser's Origin header is always exactly scheme://host[:port], so
# `https://admin.your-domain/` (the shape copied out of an address bar)
# matches nothing and looks like a broken API rather than a typo. A loopback
# or LAN origin left over from development is refused here too.
#
# NEVER "*". It is refused in every environment: this app parses the value
# into a LIST, and list entries are matched by string equality, so "*" allows
# an origin literally named "*" — i.e. nothing at all. It fails safe, but
# silently and in the opposite direction from what it looks like it does.
CORS_ORIGINS=

# PostgreSQL connection string. Use the platform's INTERNAL/private network
# hostname where one exists, and require TLS on any connection that leaves
# the provider's network (append ?sslmode=require).
DATABASE_URL=

# ── SECRETS — generate independently, never reuse one for another ───────────
#
# Generate each with:  openssl rand -base64 48
# Rotating JWT_ACCESS_SECRET/JWT_REFRESH_SECRET signs every existing session
# out. Rotating AUTH_AUDIT_IP_HASH_SECRET does not sign anyone out, but old
# and new ipHash values stop correlating.
#
# ALL THREE MUST DIFFER FROM EACH OTHER, and this is now ENFORCED at boot
# (naming the two colliding variables, never a value) rather than being an
# instruction in a comment. One value shared across them means a single leak
# forges access tokens, computes the stored hash of every refresh/reset/OTP
# token, and de-anonymises every ipHash at once — and rotating it to fix any
# one of those breaks the other two.

# Signs short-lived access tokens.
JWT_ACCESS_SECRET=

# Signs refresh tokens (which are ALSO hashed at rest in the Session table).
# Must be different from JWT_ACCESS_SECRET.
JWT_REFRESH_SECRET=

# Dedicated HMAC key for hashing client IPs into Session.ipHash and
# AuthAuditEvent.ipHash. Deliberately distinct from both JWT secrets so
# rotating one never changes the other's blast radius. Required
# unconditionally — auth auditing is on the core login path, not an add-on.
AUTH_AUDIT_IP_HASH_SECRET=

# ── REVERSE PROXY / HTTPS ───────────────────────────────────────────────────

# How many reverse proxies sit in front of this process. SET THIS TO 1 ON ANY
# MANAGED PLATFORM (Fly, Render, Railway, Cloud Run, an ALB, an nginx
# ingress) — i.e. anywhere TLS is terminated for you, which is everywhere a
# public HTTPS origin comes from.
#
# Left at 0 behind a proxy, `request.ip` is the PROXY's address for every
# caller, so every per-IP control in the app collapses onto ONE bucket: the
# 5-logins-per-minute limit becomes 5 logins per minute for the entire user
# base (a self-inflicted outage), and every Session/AuthAuditEvent ipHash
# records the same address.
#
# Set it to the REAL number of proxies. It is a hop count, never `true`:
# trusting the whole X-Forwarded-For chain would let any client prepend a
# forged address and mint unlimited rate-limit identities.
TRUST_PROXY_HOPS=1

# ── MEDIA / OBJECT STORAGE ──────────────────────────────────────────────────

# `local` (default) serves media bytes off STORAGE_ROOT through the Node
# process. `r2` serves them as short-lived presigned GET URLs straight from
# object storage. A public deployment wants `r2`: a container filesystem is
# empty on boot and discarded on every deploy.
STORAGE_DRIVER=r2

# The five OBJECT_STORAGE_* names below are REQUIRED when STORAGE_DRIVER=r2
# and unread when it is `local`. Presence is checked at boot; no network call
# is made and no credential is ever logged.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Only for a PUBLIC bucket or a custom media domain. Leave empty for a
# private bucket served by presigned URLs (the intended posture).
OBJECT_STORAGE_PUBLIC_BASE_URL=

# ── HLS DELIVERY (only if the transcode pipeline is turned on) ──────────────
#
# TRANSCODE_ENABLED=true additionally REQUIRES a reachable Redis (REDIS_URL),
# an ffmpeg/ffprobe binary, and a SEPARATE worker process (`node
# dist/worker/main`) — the API process alone does not transcode. Leave this
# false for V1 unless that whole topology exists.
TRANSCODE_ENABLED=false
REDIS_URL=

# Required when TRANSCODE_ENABLED=true. The deployed HLS gateway Worker's
# public https origin, and the HMAC key it shares with this backend. The
# secret MUST be byte-identical on both sides and MUST differ from all three
# auth secrets above (boot refuses if it matches one).
HLS_GATEWAY_BASE_URL=
HLS_TOKEN_SECRET=
HLS_TOKEN_TTL_SECONDS=3600

# Transcode retry/janitor tuning. All optional with the documented defaults
# shown, all read ONLY when TRANSCODE_ENABLED=true, and all validated at boot
# as positive integers if present (a malformed value fails the boot rather
# than silently reverting to the default). Listed so the contract covers every
# variable the code reads, not only the ones V1 turns on.
TRANSCODE_MAX_ATTEMPTS=3
TRANSCODE_STALLED_AFTER_MINUTES=30
TRANSCODE_CLEANUP_GRACE_MINUTES=120

# ── TRANSCODE WORKER RUNTIME (VPS deployment) ───────────────────────────────
# All three are OPTIONAL even when TRANSCODE_ENABLED=true, and all three are
# read ONLY by the dedicated worker process (`npm run worker:transcode`) —
# the API server never uses them. Full operational guidance, including
# per-VPS-size concurrency sizing, is in docs/TRANSCODE_WORKER_VPS.md.

# TRANSCODE_WORKER_CONCURRENCY: how many transcode jobs ONE worker process
# runs at once. Default 1, and NEVER derived from the machine's CPU count.
# Each concurrent job costs CPU, RAM *and* disk simultaneously (a full
# downloaded source plus a complete HLS package live in the temp directory
# together), so on a small VPS the first ceiling reached is memory or disk,
# not cores. Raise this only against a box you have measured. Boot FAILS if
# this is set to anything that is not a positive integer — a silent fallback
# to 1 would leave an operator believing a change took effect when it did not.
TRANSCODE_WORKER_CONCURRENCY=1

# TRANSCODE_TEMP_DIR: parent directory for each job's own isolated temp
# working directory. Unset means os.tmpdir(). Point this at a volume with
# real headroom (several times the largest source file, times the concurrency
# above) rather than a container's small default /tmp. The directory is
# created at startup if it does not exist. Never validated by shape at boot —
# an unusable path surfaces at the first job with the OS's own error.
TRANSCODE_TEMP_DIR=

# TRANSCODE_TEMP_SWEEP_MIN_AGE_MINUTES: how long a leftover per-job temp
# directory must sit untouched before the worker's startup/periodic sweep
# deletes it. Default 120. This reclaims scratch stranded by a SIGKILL, an
# OOM kill or a power loss, which skip the normal per-job cleanup. Kept above
# TRANSCODE_STALLED_AFTER_MINUTES (30) on purpose: anything old enough to be
# swept is, by construction, no longer owned by a live job — which is what
# makes the sweep safe when more than one worker shares a temp volume.
TRANSCODE_TEMP_SWEEP_MIN_AGE_MINUTES=120

# ── IDENTITY PROVIDERS ──────────────────────────────────────────────────────

# Google Sign-In — REQUIRED FOR V1. Red Panda V1 ships Google Login AND
# WhatsApp Login, so both variables below are RELEASE BLOCKERS in
# `npm run production:preflight` and `npm run release:gate`: with the flag
# off, POST /auth/google answers 503 and the login screen's Google button is
# dead. (A release rule, not a boot rule — development and test still start
# with no Google configuration at all.)
#
# NO CLIENT SECRET IS INVOLVED: the client obtains the ID
# token and this backend only VERIFIES it, against Google's public JWKS.
# GOOGLE_OAUTH_CLIENT_IDS is the audience allowlist and is REQUIRED (at least
# one non-empty entry) when enabled — an empty allowlist would 401 every
# legitimate sign-in. Comma-separated for multiple platforms. It must include
# the WEB client id the mobile app mints its token against, and the client
# must be registered to com.spark.redpanda.
GOOGLE_AUTH_ENABLED=true
GOOGLE_OAUTH_CLIENT_IDS=

# WhatsApp OTP — REQUIRED FOR V1. Red Panda V1 ships Google Login AND
# WhatsApp Login, so this is not an optional provider: with the flag off,
# every /auth/whatsapp/* route answers 503 and half the login screen is dead.
#
# `cloud-api` is the production driver (Meta WhatsApp Cloud API). Boot
# REFUSES an enabled provider whose driver is missing, unimplemented, or
# `fake` outside NODE_ENV=development/test, and refuses a `cloud-api` driver
# whose sender configuration is incomplete — so there is no posture in which
# this process starts and silently fails to deliver codes.
#
# The four values below come from Meta and CANNOT be invented. Obtain them by
# following docs/WHATSAPP_LOGIN_SETUP.md, then fill them in here.
WHATSAPP_AUTH_ENABLED=true
WHATSAPP_OTP_PROVIDER_DRIVER=cloud-api

# Graph API "Phone number ID" of the sending WhatsApp Business number — a
# numeric id from the Meta dashboard, NOT the phone number. Not a secret.
WHATSAPP_CLOUD_API_PHONE_NUMBER_ID=

# SECRET. A permanent System User token with whatsapp_business_messaging on
# the sending number. Do NOT use the dashboard's 24-hour temporary token: it
# expires, and every WhatsApp login stops the moment it does. Never commit
# this file with a value in this line.
WHATSAPP_CLOUD_API_ACCESS_TOKEN=

# Exact name of the APPROVED AUTHENTICATION-category template, and its
# language code exactly as approved (e.g. `id`). A mismatch in either is a
# send failure answered as 503, never a silent fallback.
WHATSAPP_CLOUD_API_TEMPLATE_NAME=
WHATSAPP_CLOUD_API_TEMPLATE_LANGUAGE=

# The last two WhatsApp variables the code reads. BOTH ARE OPTIONAL and both
# are listed here for the same reason the transcode tuning knobs above are:
# this contract covers every variable the code reads, not only the ones a
# release sets. Leave both commented out unless the stated condition applies.
#
# Graph API version, interpolated into the request URL. Validated at boot
# (even while the feature is off) as `v<major>.<minor>` — a misspelling is
# refused rather than allowed to steer the request somewhere unintended.
# Unset uses the version this client was written against.
# WHATSAPP_CLOUD_API_GRAPH_VERSION=v21.0
#
# Set to `false` ONLY if you deliberately approved a template with NO
# one-time-password button. Defaults to TRUE (note the inverted `!== 'false'`
# parse — this is the one flag in this file that is on unless switched off),
# because Meta requires that button on authentication templates. A wrong
# value here is a send failure, not a fallback. See
# docs/WHATSAPP_LOGIN_SETUP.md §4.
# WHATSAPP_CLOUD_API_TEMPLATE_HAS_OTP_BUTTON=true

# ── REWARDS ─────────────────────────────────────────────────────────────────

# Points ledger, daily check-in, social + watch missions, and redemption into
# ad perks. While false, every /rewards/* route answers 503 REWARDS_DISABLED
# and no watch credit is recorded — a deliberate, honest dark state, not a
# broken one.
#
# V1 IS SPECIFIED AS FREE CONTENT + ADS + REWARDS, so a V1 release sets this
# to true. `npm run production:preflight` BLOCKS while it is off — shipping a
# V1 build with no earn loop is not a posture to confirm by hand, it is a
# release that is not V1.
REWARDS_ENABLED=true

# IANA zone defining the daily check-in boundary. Validated at boot
# UNCONDITIONALLY (even while rewards are dark), because a typo would
# otherwise 500 every rewards request once the flag is flipped.
REWARDS_TIMEZONE=Asia/Jakarta

# The official Red Panda profile each social mission opens. REQUIRED for a V1
# release — a mission with no URL is not served at all, so leaving one blank
# silently ships a Rewards Center missing part of the earn loop, with no error
# anywhere for anyone to notice. `npm run production:preflight` BLOCKS on any
# of the three V1 platforms below being unset.
#
# FACEBOOK IS NOT REQUIRED and is left blank on purpose — V1 specifies
# Instagram, TikTok and YouTube. Fill the Facebook line in only if the product
# actually wants that tile.
#
# THESE MISSIONS DO NOT VERIFY A FOLLOW and the backend never claims they do.
# No platform exposes a follow check for an arbitrary user, so a claim records
# a USER-CONFIRMED EXTERNAL ACTION: the server handed the user this link and
# the user came back and confirmed. Ledger reason EXTERNAL_SOCIAL_ACTION; API
# field verification: "USER_CONFIRMED". See docs/rewards-api-contract.md §6.
#
# Boot refuses a value that is not https, is not on that platform's own
# domains, or points at the platform home page instead of a profile. The
# preflight additionally BLOCKS a release whose URL still contains a template
# segment such as "your-handle".
REWARDS_SOCIAL_INSTAGRAM_URL=https://www.instagram.com/your-handle
REWARDS_SOCIAL_TIKTOK_URL=https://www.tiktok.com/@your-handle
REWARDS_SOCIAL_YOUTUBE_URL=https://www.youtube.com/@your-handle
REWARDS_SOCIAL_FACEBOOK_URL=

# ── ADS (public, non-secret tuning for GET /config/ads) ─────────────────────
#
# All optional with documented defaults. Values here are coarse pacing knobs
# read by the mobile interstitial gate; none is a credential. The AdMob app
# id and ad unit id live in the MOBILE build, never here.
ADS_INTERSTITIAL_ENABLED=true
ADS_MIN_VIDEOS_BETWEEN_ADS=3
ADS_MAX_VIDEOS_BETWEEN_ADS=6
ADS_MIN_SECONDS_BETWEEN_ADS=120
ADS_GRACE_VIDEOS=5

# ── PAYMENTS — OFF FOR V1 ───────────────────────────────────────────────────
#
# While PAYMENTS_ENABLED is not the literal string "true", every /payments/*
# route answers 503 PAYMENTS_DISABLED and no Midtrans credential is read or
# required. MIDTRANS_IS_PRODUCTION=true is separately refused at boot unless
# NODE_ENV is exactly "production" — so a real-money endpoint can never be
# reached from a staging process by accident.
PAYMENTS_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# ── MUST BE SET / MUST STAY UNSET FOR PRODUCTION ────────────────────────────

# Required for the fail-closed guards above to recognise this as production.
NODE_ENV=production

# Opens /dev/entitlements/* AND /dev/admin/* — the latter is SELF-SERVICE
# ADMIN-ROLE GRANT, i.e. privilege escalation. Boot REFUSES when this is true
# unless NODE_ENV is exactly development or test (a fail-closed allowlist, not
# a "!== production" check). Keep it false; it also gates /health/details.
DEV_TOOLS_ENABLED=false

# Retention job scheduler. Leave off unless deliberately operating it; it has
# its own independent environment guard.
RETENTION_SCHEDULE_ENABLED=false
RETENTION_SCHEDULE_CRON=0 3 * * *
RETENTION_SCHEDULE_COMMIT=false

# NEVER SET IN THE RUNNING SERVICE'S ENVIRONMENT: DATABASE_URL_TEST,
# RUN_R2_SMOKE, RUN_R2_MEDIA_SMOKE, RUN_R2_HLS_SMOKE,
# SERIES_COVER_ORPHAN_APPLY_BUCKET, R2_MEDIA_MIGRATION_APPLY_BUCKET.
#
# These belong to the test and maintenance surfaces only. The last two are
# deliberate write-authorization gates for hand-run CLIs (the cover-orphan
# cleanup and the R2 media migration): each must be supplied inline on the
# one command that needs it, e.g.
#
#   R2_MEDIA_MIGRATION_APPLY_BUCKET="$OBJECT_STORAGE_BUCKET" \
#   npm run media:r2-migrate -- --upload
#
# Baking either into the service environment would leave a standing
# authorization to write, which is exactly what the restatement exists to
# prevent. See docs/R2_MEDIA_MIGRATION.md.

# ── MEDIA REALITY CHECK (read before the first deploy) ──────────────────────
#
# Setting STORAGE_DRIVER=r2 does NOT by itself move existing content. A video
# row is served from object storage only if that ROW carries an
# `objectStorageKey` (or a completed `hlsMasterKey`); a row with only a
# `storageKey` is still served off STORAGE_ROOT by the Node process, which on
# a container means an empty directory and a 404.
#
# Audit the target database before trusting playback:
#
#   SELECT count(*) FILTER (WHERE "objectStorageKey" IS NOT NULL) AS on_r2,
#          count(*) FILTER (WHERE "objectStorageKey" IS NULL
#                             AND "hlsMasterKey" IS NULL)        AS local_only
#   FROM "Video" WHERE "lifecycleState" = 'published';
#
# Every `local_only` row must have its media uploaded to the bucket and its
# `objectStorageKey` set before a guest can play it over the public internet.

# ---------------------------------------------------------------------------
# CONTENT ACCESS MODE  (work unit "V1 FREE ACCESS POLICY")
# ---------------------------------------------------------------------------
# CONTENT_ACCESS_MODE: which content-access policy this deployment enforces.
# Shaped like STORAGE_DRIVER (a NAMED-MODE allowlist), not like the
# TRANSCODE_ENABLED/PAYMENTS_ENABLED exact-string boolean flags — a typo here
# FAILS THE BOOT rather than silently resolving to a mode, because this
# setting has no "safe direction" to fall back in.
#
#   entitlement  (the DEFAULT — unset or empty resolves here)
#                Today's behavior, byte-for-byte. An episode's effective tier
#                is its explicit Video.accessTierOverride when set, otherwise
#                the episodeNumber > FREE_EPISODE_LIMIT (5) derivation, and a
#                premium episode requires an active Entitlement to stream:
#                403 ENTITLEMENT_REQUIRED otherwise.
#
#   free         The Red Panda V1 Google Play policy. The app ships free and
#                ad-monetized with NO purchase flow of any kind, so an episode
#                that resolves premium is not "behind a paywall" — it is
#                permanently unreachable. In this mode EVERY published catalog
#                episode resolves accessTier 'free': the playback gate allows
#                it (guest or signed-in), GET /videos/:id and /videos/feed
#                report accessTier 'free', HLS authorization is returned
#                normally, requiresAuthHeader is false for local-storage rows,
#                and SeriesPublicDto.hasPremiumEpisodes reports false.
#
# PRECEDENCE (deliberate, and the reason for this variable): free mode
# outranks EVERY per-row tier, including an explicit accessTierOverride of
# 'premium'. The override is a statement about the CATALOG; the mode is a
# statement about the DEPLOYMENT. When the deployment cannot sell anything, a
# premium row is content no user can reach by any action available to them.
#
# WHAT IT DOES NOT DO. It grants nobody premium and writes nothing. The
# Entitlement model/service, reward redemption, payments, the
# accessTierOverride column and every value stored in it, the entitlement gate
# itself, and the premium DTO types are all untouched and stay live:
# GET /users/me/entitlement still reports isPremium false for a non-entitled
# viewer in free mode, and a real grant still reads back as premium.
# Ads are entirely independent — GET /config/ads reads only its own ADS_*
# variables and never consults content tier or entitlement.
#
# REVERSIBLE: setting this back to entitlement (or removing it) restores the
# previous enforcement exactly, with no migration and no catalog change,
# because the stored per-row tiers were never modified.
#
# ── WHY THIS TEMPLATE SHIPS `free` AND NOT THE `entitlement` DEFAULT ────────
#
# This line used to read `entitlement`, which is the code default and was, for
# this release, a trap: a release owner who copied this file exactly — the one
# thing this file exists to be copied for — would have shipped V1 with per-row
# enforcement on.
#
# V1 HAS NO WAY TO UNLOCK A PREMIUM ROW. PAYMENTS_ENABLED=false and every
# /payments/* route answers 503; the reward catalog's VIP redemptions are
# suppressed in free mode and buy nothing a V1 user can reach. So an episode
# whose accessTierOverride is "premium" is not "behind a paywall" in this
# release — it is listed in the feed and permanently unplayable, by anyone,
# with no error for anyone to notice. The catalog carries such rows today.
#
# `npm run production:preflight` now BLOCKS any mode other than `free`, for
# the same stated reason it blocks WHATSAPP_AUTH_ENABLED and REWARDS_ENABLED
# being off: the V1 integration decides what V1 is, and a report that answered
# "no blockers" for a build with half its catalog dead would be certifying a
# release that is not V1.
#
# A deployment that genuinely wants per-row enforcement sets `entitlement`
# here deliberately and accepts that its preflight blocks — that deployment is
# not this release.
CONTENT_ACCESS_MODE=free
