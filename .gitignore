# compiled output
/dist
/node_modules
/build

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Company video media — never commit real video assets or storage folders
*.mp4
*.mov
*.mkv
/company-video-storage/
/VideoDracin/
/storage/

# Prisma / SQLite local dev database artifacts (never commit real data)
*.db
*.db-journal

# Local database backups (never commit real/backup data)
/prisma/backups/

# CI-1: ephemeral placeholder-media storage root and failure-only log
# artifacts generated by .github/workflows/ci.yml / npm run media:fixtures.
# Never real company media; never committed.
/.ci-storage/
/ci-logs/

# Slice 11Q — workers/hls-gateway is its OWN, fully independent npm package
# (own package.json/package-lock.json, deliberately not an npm workspace of
# the root package.json) — its node_modules/build output never belong in
# the root package's dependency tree and must never be committed. There is
# also no real `wrangler.toml` (only the committed `wrangler.toml.example`
# template) — see that file's own header comment for why a real one must
# never be created/committed in this slice.
/workers/*/node_modules/
/workers/*/dist/
/workers/*/wrangler.toml
