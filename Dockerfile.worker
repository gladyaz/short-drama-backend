# =============================================================================
# Red Panda HLS transcoding worker — production image.
#
# Work unit "TRANSCODE WORKER VPS DEPLOYMENT". Builds ONLY the queue-consuming
# worker (`node dist/worker/main`). The API server is a DIFFERENT process from
# the same source tree and is deliberately not started here: nothing in this
# image opens a listening port, and the worker's own entry point uses
# `NestFactory.createApplicationContext` — there is no `app.listen()` anywhere
# in its graph (Slice 11O approval, binding constraint 2).
#
# NO SECRET IS EVER BAKED IN. There is no `.env` in the build context
# (`.dockerignore` excludes it) and no `ARG`/`ENV` below carries a credential.
# Every secret arrives at RUN time through the container environment —
# `env_file:` in `docker-compose.worker.yml`, or `EnvironmentFile=` in the
# systemd unit in `docs/TRANSCODE_WORKER_VPS.md`.
#
# Build:  docker build -f Dockerfile.worker -t red-panda-transcode-worker .
# Run:    see docs/TRANSCODE_WORKER_VPS.md
# =============================================================================

# Node 22 — the ONLY line that decides the runtime version, and it matches
# `package.json`'s `engines` (>=22 <25), `.nvmrc` (22), and the CI workflow.
# `bookworm-slim` rather than Alpine deliberately: Prisma's query engine ships
# a glibc build (`debian-openssl-3.0.x`) that needs no musl special-casing, and
# Debian's `ffmpeg` package is a full build with the encoders this pipeline
# uses. HARDENING NOTE: pin this to a digest (`node:22-bookworm-slim@sha256:...`)
# once an operator has chosen one, for a byte-identical rebuild.
FROM node:22-bookworm-slim AS base
WORKDIR /app
ENV NODE_ENV=production

# -----------------------------------------------------------------------------
# Builder — full dependency tree, Prisma client generation, TypeScript build.
# -----------------------------------------------------------------------------
FROM base AS builder
ENV NODE_ENV=development

# Lockfile-only layer first, so a source-only change does not reinstall.
COPY package.json package-lock.json ./
COPY prisma ./prisma

# `npm ci` (never `npm install`) — installs EXACTLY the locked tree, so two
# builds of the same commit produce the same dependencies.
#
# `--ignore-scripts` makes that determinism real: it stops any package's
# postinstall from silently deciding what ends up in the image. Prisma's client
# is then generated by the EXPLICIT command below instead of as a hidden side
# effect of installation, which is also why a generation failure surfaces here
# as a failed build rather than as a container that starts and cannot query.
RUN npm ci --ignore-scripts

COPY tsconfig.json tsconfig.build.json nest-cli.json ./
COPY src ./src

RUN npx prisma generate
RUN npm run build

# Reduce the dependency tree to production-only IN PLACE, keeping the generated
# Prisma client (which lives in `node_modules/.prisma`, outside the package
# tree `prune` walks). The runtime stage copies the result, so devDependencies
# — the compiler, the test runner, the linter, `ts-node`, `dotenv` — never
# exist in the shipped image at all.
RUN npm prune --omit=dev

# -----------------------------------------------------------------------------
# Runtime — FFmpeg, production dependencies, compiled output. Nothing else.
# -----------------------------------------------------------------------------
FROM base AS runtime

# `ffmpeg` brings `ffprobe` in the same Debian package; both are required and
# both are verified by `npm run worker:health`.
# `ca-certificates` is NOT optional: without it every HTTPS call to R2 fails
# certificate verification, which surfaces as an unexplained SOURCE_MISSING on
# every single job.
# `openssl` is Prisma's query-engine dependency.
# The apt lists are deleted in the SAME layer that created them, so the cache
# never becomes part of the shipped image.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
       ffmpeg \
       ca-certificates \
       openssl \
  && rm -rf /var/lib/apt/lists/*

# Scratch space for per-job temp directories. Given to the `node` user because
# the process below is NOT root. `docker-compose.worker.yml` mounts a volume
# here — a single job holds a full downloaded source AND a complete HLS package
# at once, so this is the one path that genuinely needs headroom.
RUN mkdir -p /app/tmp /app/storage && chown node:node /app/tmp /app/storage
ENV TRANSCODE_TEMP_DIR=/app/tmp \
    STORAGE_ROOT=/app/storage

# WHY STORAGE_ROOT EXISTS IN AN R2-ONLY IMAGE. The worker reuses the API's
# `validateEnv` verbatim — one source of truth for what this repo's variables
# mean — and that validator requires STORAGE_ROOT to be set AND to be an
# existing directory, UNCONDITIONALLY, before it ever looks at STORAGE_DRIVER.
# With STORAGE_DRIVER=r2 nothing is ever written here, but without the
# directory the worker cannot boot at all. Shipping an empty one turns a
# confusing first-boot crash into a non-event. An operator may override it.

COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/dist ./dist
COPY --from=builder --chown=node:node /app/prisma ./prisma
COPY --chown=node:node package.json ./package.json

# Non-root. `node` (uid 1000) ships with the base image. The worker needs no
# privileged capability whatsoever: it dials out to Redis and R2 and spawns
# FFmpeg, all of which work unprivileged.
USER node

# Explicit, though it is already Docker's default — this image's entire
# shutdown contract depends on the process receiving SIGTERM. See
# `src/worker/worker-shutdown.ts`: the handler stops taking new jobs and then
# waits for the in-flight encode to reach a safe boundary. THE DEPLOYMENT MUST
# ALLOW TIME FOR THAT — Docker's default 10-second grace would SIGKILL a
# running encode, so `docker-compose.worker.yml` sets `stop_grace_period`.
STOPSIGNAL SIGTERM

# Proves the three things a worker needs in order to be useful at all: valid
# configuration, both FFmpeg binaries, and a Redis round-trip. Invoked directly
# as `node` (not through npm) so the check never touches the network.
# `start-period` is generous because the very first check can race the boot.
HEALTHCHECK --interval=60s --timeout=15s --start-period=30s --retries=3 \
  CMD ["node", "dist/worker/health-main"]

# PID 1 is Node itself, which runs the SIGTERM handler directly. Run the
# container with an init (`init: true` in compose, `--init` on the CLI) so
# FFmpeg child processes are reaped rather than accumulating as zombies.
CMD ["node", "dist/worker/main"]
