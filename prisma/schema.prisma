// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String                 @id @default(cuid())
  /// PHASE 10B (production identity providers): NULLABLE as of the
  /// `add_auth_identity_and_phone_otp` migration. It was `String @unique`
  /// (NOT NULL) for every phase before this one, because the only way to
  /// create an account was `POST /auth/register`, which always supplies an
  /// email. A WHATSAPP-only account has no email at all — the user proved
  /// ownership of a phone number, nothing more — and inventing a synthetic
  /// placeholder ("+6281234567890@whatsapp.local") would be a lie that a
  /// later `POST /auth/password-reset/request` could act on. `NULL` is the
  /// truthful representation. Postgres permits ANY number of NULLs in a
  /// unique index, so `@unique` still enforces "at most one account per
  /// real email" exactly as before while allowing many email-less accounts.
  ///
  /// Every pre-existing row keeps its non-null value untouched — dropping a
  /// NOT NULL constraint rewrites no data. This column is NOT the identity
  /// key for any provider: `AuthIdentity.providerSubject` is (see that
  /// model), and a Google account is resolved by its Google `sub`, never by
  /// the email Google reports.
  email               String?                @unique
  /// PHASE 10B: NULLABLE as of the same migration, for the same class of
  /// reason — a GOOGLE-only or WHATSAPP-only account has no password, and
  /// storing a random unusable hash instead would be indistinguishable from
  /// a real credential to every `bcrypt.compare` call site.
  ///
  /// SECURITY-CRITICAL CONSEQUENCE: every call site that compares a
  /// caller-supplied password against this column MUST explicitly refuse
  /// when it is `null`, BEFORE deciding the caller is authenticated —
  /// never rely on the comparison itself to fail. `AuthService.login`,
  /// `.changePassword` and `.deleteAccount` fall back to
  /// `DUMMY_HASH_FOR_TIMING_PARITY` purely to keep response latency
  /// constant, and that dummy hash is a FIXED, committed constant: if its
  /// plaintext preimage were ever discovered, an implicit "the compare
  /// returned false" check would let it authenticate as every passwordless
  /// account in the database. Each of those three methods therefore carries
  /// an explicit `passwordHash === null` refusal.
  passwordHash        String?
  displayName         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  sessions            Session[]
  videoInteractions   UserVideoInteraction[]
  watchProgress       WatchProgress[]
  entitlements        Entitlement[]
  analyticsEvents     AnalyticsEvent[]
  /// Phase 11, work unit 11B-2: authorizes the admin-guarded `/admin/media`
  /// API (11B-3). Plain `String` (not a Postgres enum), matching the
  /// existing `Video.category`/`Entitlement.tier` precedent — no second
  /// role exists yet, and a string avoids a schema migration if one is
  /// added later. Defaults to `"user"` so every pre-existing account (and
  /// every caller creating a `User` without specifying it, e.g.
  /// `AuthService.register`) is non-admin by default; becoming an admin is
  /// an explicit, separate action (`AdminGuard`'s DEV-ONLY grant route,
  /// gated by the existing `DEV_TOOLS_ENABLED`/`DevToolsGuard` precedent —
  /// there is no real admin-provisioning flow yet).
  role                String                 @default("user")
  /// Phase 12, work unit 12A-B1: persistent per-account failed-login/lockout
  /// state. Optional 1:1 — most users never have a row here (one is only
  /// created lazily on that account's first failed login attempt via
  /// `AccountLockoutService`). See `AccountLockout` below for the full
  /// design rationale.
  accountLockout      AccountLockout?
  /// Phase 12, work unit 12A-B3: operational security audit trail. Nullable
  /// FK with `onDelete: SetNull` (NOT `Cascade`), mirroring the existing
  /// `AnalyticsEvent.userId` precedent — deleting a `User` lets their audit
  /// history survive instead of being destroyed, which matters for an
  /// operational-security log (e.g. investigating account-takeover activity
  /// must survive the attacker later deleting the compromised account).
  /// `SetNull` alone only nulls this `userId` column, though — it does NOT
  /// by itself anonymize a surviving row, because `ipHash` (a globally
  /// stable, unsalted, unrotated HMAC) would still correlate it. Phase 12E,
  /// work unit 12E-B1 adds an explicit pre-delete scrub of
  /// `ipHash`/`userAgent`/`metadata` that does the real anonymizing work.
  /// See `AuthAuditEvent` below for the full design rationale.
  authAuditEvents     AuthAuditEvent[]
  /// Phase 12, work unit 12B-B3: `POST /auth/password-reset/*`. Cascades
  /// with the `User` (`onDelete: Cascade`, NOT `SetNull`) — unlike
  /// `AuthAuditEvent` above, an outstanding reset-token row has no
  /// standalone value once its account no longer exists; there is nothing
  /// to investigate or anonymize, matching the `Session`/`AccountLockout`
  /// precedent instead. See `PasswordResetToken` below for the full design
  /// rationale.
  passwordResetTokens PasswordResetToken[]
  /// Work unit "MIDTRANS PAYMENT BACKEND FOUNDATION": payment orders this
  /// user has initiated. Nullable back-reference with `onDelete: SetNull`
  /// (NOT `Cascade`), mirroring the `AuthAuditEvent` precedent above rather
  /// than the `Session`/`AccountLockout` one: a payment order is a financial
  /// audit record — deleting an account must not destroy the history of what
  /// was charged and what was granted for it. Unlike `AuthAuditEvent`, no
  /// pre-delete scrub is needed: a `PaymentOrder` row carries no PII (no
  /// email, IP, user agent, or card data — only plan/amount/status fields
  /// and server-generated identifiers; see the `PaymentOrder` model below).
  paymentOrders       PaymentOrder[]
  /// PHASE 10B (production identity providers): every authentication method
  /// that resolves to this account — email/password, Google, WhatsApp.
  /// Cascades with the `User` (`onDelete: Cascade`, matching
  /// `Session`/`AccountLockout`/`PasswordResetToken`, NOT `AuthAuditEvent`'s
  /// survive-and-scrub): a credential binding for an account that no longer
  /// exists is dead weight, and — unlike an audit row — leaving it behind
  /// would leave a live Google `sub` / phone number in the database pointing
  /// at nothing. See `AuthIdentity` below for the full design rationale.
  authIdentities      AuthIdentity[]
  /// Work unit "REWARDS BACKEND FOUNDATION": the user's points economy.
  /// All four cascade with the `User` (`onDelete: Cascade`), following the
  /// `Session`/`AccountLockout`/`PasswordResetToken` precedent rather than
  /// `PaymentOrder`/`AuthAuditEvent`'s survive-and-anonymize one. The
  /// distinction is deliberate: a `PaymentOrder` is a FINANCIAL record of
  /// real money that must outlive the account, whereas reward points are an
  /// internal, non-monetary loyalty balance with no external counterparty —
  /// once the account is gone there is no one to owe them to, nothing to
  /// reconcile against a bank, and no dispute that could be raised. Keeping
  /// an orphaned ledger would preserve a behavioral history (what someone
  /// watched and when they opened the app) for no operational benefit, which
  /// is the opposite of what account deletion is for.
  ///
  /// Cascade order is safe against `AuthService.deleteAccount`: that
  /// transaction locks the `User` row FIRST (see the CANONICAL AUTH LOCK
  /// ORDER block in `auth.service.ts`), and every rewards transaction locks
  /// the same `User` row first too, so the two can never interleave into a
  /// cycle.
  rewardWallet        RewardWallet?
  rewardLedgerEntries RewardLedgerEntry[]
  rewardCheckIn       RewardCheckIn?
  rewardRedemptions   RewardRedemption[]
}

// Phase 12, work unit 12A-B1: persistent (PostgreSQL, survives restart)
// per-account failed-login/lockout state (see DECISIONS.md "Phase 12 ...
// approved..." entry, decision 4). A single counter row per user, upserted
// in place, rather than a full `LoginAttempt` log table — sufficient to
// enforce "lock 15 minutes after 10 failed logins within a rolling
// 15-minute window" without persisting a per-attempt audit trail (that is a
// separate, later concern — 12A-B3's `AuthAuditEvent` — not duplicated
// here). `userId` is `@unique` with `onDelete: Cascade` so deleting a `User`
// row (12C-B1, a later work unit) cleans this up automatically, matching
// every other user-owned model in this schema.
//
// `windowStartedAt`/`failedCount` track the CURRENT rolling failure window:
// a failure either starts a new window (`windowStartedAt` null, or older
// than the 15-minute window) or increments the existing one.
// `lockedUntil` (nullable) is set only once `failedCount` reaches the
// 10-failure threshold within that window; the account is considered locked
// exactly while `lockedUntil` is non-null AND still in the future. A
// successful login resets all three fields back to their unlocked defaults
// (`failedCount: 0`, `windowStartedAt: null`, `lockedUntil: null`).
//
// This table is read/written ONLY by `AccountLockoutService`, and only for
// email addresses that resolve to an EXISTING `User` row — a nonexistent
// email never causes a row to be created here (see
// `AuthService.login`), so this table itself cannot be used to enumerate
// which emails are registered. Its state is NEVER surfaced in any API
// response: every outcome it can produce collapses to the same generic
// `INVALID_CREDENTIALS` error in `AuthService.login`, per the
// anti-enumeration requirement in DECISIONS.md.
model AccountLockout {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  failedCount     Int       @default(0)
  windowStartedAt DateTime?
  lockedUntil     DateTime?
  updatedAt       DateTime  @updatedAt

  @@index([lockedUntil])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  /// Phase 12, work unit 12B-B2 (DECISIONS.md "Phase 12 ... approved..."
  /// entry, decision 6): additive, nullable session metadata surfaced by
  /// `GET /auth/sessions` (never a hash/secret — see `SessionSummaryDto` in
  /// `auth.types.ts`). All three are nullable with NO default so every
  /// pre-existing row (and any caller creating a `Session` without them)
  /// backfills to `null` — this migration changes no existing row's value.
  /// `userAgent`: the RAW `User-Agent` header value, truncated/sanitized by
  /// `sanitizeUserAgent` (`auth-crypto.ts`) before it ever reaches this
  /// column — never persisted verbatim/unbounded. `ipHash`: an HMAC-SHA256
  /// digest of the client IP (`hashIp`, `auth-crypto.ts`), keyed with the
  /// SAME dedicated `AUTH_AUDIT_IP_HASH_SECRET` `AuthAuditService` already
  /// uses for `AuthAuditEvent.ipHash` — the raw IP is never computed into
  /// this column or persisted anywhere else on this row. `lastUsedAt`: set
  /// whenever this row is created (`AuthService.issueTokensAndSession`) and
  /// again on the OLD row at the moment it is rotated out by a refresh (see
  /// `AuthService.refresh`) — this app's access tokens are stateless JWTs
  /// verified without a DB hit (`JwtAuthGuard`), and refresh tokens rotate
  /// on every use rather than being mutated in place, so there is no
  /// separate "heartbeat"/"touch" event distinct from create-or-rotate to
  /// wire this into.
  userAgent        String?
  ipHash           String?
  lastUsedAt       DateTime?

  @@index([userId])
}

// Phase 8, work unit 8-B4: flat mirror of `VideoRecord`
// (src/videos/video.types.ts). `id` intentionally has no @default — the
// existing 40 records carry meaningful, pre-assigned ids (e.g.
// "video-104-01") that must be preserved exactly via the seed script, not
// regenerated. `seriesId` is a plain string, not a relation: there is no
// separate Series entity today (episodes are grouped client-side from the
// flat feed response), and introducing one is out of scope for this work
// unit.
model Video {
  id                            String    @id
  seriesId                      String
  title                         String
  episodeNumber                 Int
  channelName                   String
  caption                       String
  category                      String
  storageKey                    String
  sourceLanguage                String
  hasEmbeddedIndonesianSubtitle Boolean
  likeCount                     Int
  durationSeconds               Int?
  width                         Int?
  height                        Int?
  /// Work unit 8-B4 fix cycle 1: explicit, deterministic feed ordering.
  /// `seriesId`/`episodeNumber` ordering does NOT reproduce the original
  /// curated order in `videos.data.ts` (series-104 first, then series-010,
  /// series-101, series-105 — not alphabetical by seriesId), so a plain
  /// column carrying that intent is used instead. Defaults to 0 so existing
  /// callers (e.g. `seed.ts`, `videos.service.spec.ts`) that create/update
  /// `Video` rows without specifying it keep compiling; the additive
  /// migration backfills the correct value for the 40 pre-existing rows.
  sortOrder                     Int       @default(0)
  /// Phase 11, work unit 11A-2: object-storage fields for the upcoming
  /// R2/S3-compatible media pipeline (11B/11D), added alongside the existing
  /// `storageKey` (local `STORAGE_ROOT`-relative path — untouched, still the
  /// sole field `VideosController#streamVideo` resolves against; see
  /// DECISIONS.md "Phase 11 runbook reviewed..." entry: this slice does NOT
  /// cut streaming over to object storage, that is 11A-3, out of scope).
  /// All four are nullable with no default, so every existing row (and every
  /// caller that creates/updates a `Video` without them, e.g. `seed.ts`)
  /// keeps compiling and importing unchanged; they are populated only once a
  /// video is actually uploaded to object storage via the 11B-3 admin API.
  /// `objectStorageVariant` is a free-form label (e.g. "source", "720p")
  /// rather than a separate join table — no real transcoding/rendition
  /// pipeline exists yet, and a plain string avoids a schema migration when
  /// one is added later (matching the existing `Video.category` precedent).
  objectStorageKey              String?
  objectStorageVariant          String?
  coverImageKey                 String?
  thumbnailImageKey             String?
  /// Phase 11, work unit 11A-2 (state machine itself lands in 11B-1):
  /// defaults to `"published"` so every one of the 40 pre-existing rows
  /// stays exactly as playable/streamable as it is today after this
  /// additive migration runs — none of them silently become a draft. New
  /// media uploaded through the 11B-3 admin API starts at `"draft"`
  /// instead, set explicitly by that endpoint rather than relying on this
  /// column default (which exists for backfill safety, not as the intended
  /// state for freshly created rows).
  lifecycleState                String    @default("published")
  /// Explicit catalog content classification (`VideoContentKind` in
  /// `src/videos/video-content-kind.types.ts`): `"drama"` for real,
  /// user-facing content, `"qa_fixture"` for internal technical fixtures that
  /// live in the catalog on purpose (the 11R HLS sample, a disposable
  /// admin-upload test row). It exists because NO pre-existing field could
  /// tell the two apart reliably — `sourceLanguage` describes the content's
  /// language rather than its realness, an empty `storageKey` is how
  /// R2-backed media is legitimately represented, and title/channelName are
  /// display strings. Clients must READ this field, never infer it.
  ///
  /// Defaults to `"drama"` so the additive migration leaves every one of the
  /// 42 pre-existing rows a normal catalog row — the same backfill-safety
  /// reasoning as `lifecycleState`/`sortOrder` above — and so a future admin
  /// upload, which is real content, is correctly classified without the
  /// caller having to remember. The two known synthetic rows are set to
  /// `"qa_fixture"` by a targeted, id-scoped QA-data reconciliation statement
  /// in the same migration; that statement is data cleanup for two known
  /// fixtures, NOT runtime classification logic.
  ///
  /// Plain `String`, not a Postgres enum, matching the
  /// `category`/`lifecycleState`/`Entitlement.tier` precedent: a third kind
  /// (trailer, promo) then needs no SCHEMA migration — but it does need the
  /// `VideoContentKind` enum and `toVideoContentKind()` updated, because that
  /// narrowing function reports anything it does not recognise as `drama`
  /// (and logs a warning). "No migration" is not "no code change".
  ///
  /// DELIBERATELY NOT FILTERED SERVER-SIDE. `VideosService#findAll` still
  /// returns qa_fixture rows, so internal QA and the 11R playback sample keep
  /// working exactly as before; excluding them from a consumer catalog is the
  /// presenting client's decision.
  contentKind                   String    @default("drama")
  /// Phase 11, work unit 11E-3: per-episode admin access-tier override.
  /// Nullable with NO default, so every one of the 40 pre-existing rows (and
  /// every caller that creates/updates a `Video` without specifying it, e.g.
  /// `seed.ts`, `AdminMediaService.createUpload`) keeps compiling and
  /// backfills to `null` — the additive migration for this column changes no
  /// existing row's value. `null` means "no override, use the default
  /// `episodeNumber >= FREE_EPISODE_LIMIT` rule" (see
  /// `EntitlementsService.resolveEpisodePremium`, which is the ONLY code path
  /// that reads this column); `"premium"`/`"free"` unconditionally decide the
  /// outcome regardless of `episodeNumber`. A plain string, not a Postgres
  /// enum, matching the existing `Video.category`/`Entitlement.tier`
  /// precedent — set/cleared only via the guarded
  /// `PATCH /admin/media/:id/access-tier` endpoint
  /// (`UpdateAccessTierDto` validates it to exactly `"free" | "premium" |
  /// null`). Deliberately NOT exposed on the public `VideoResponseDto` — see
  /// `AdminMediaDto` for its only intended external exposure.
  accessTierOverride            String?
  /// Phase 11, work unit 11L-B1: the server-side upload EXPECTATION recorded
  /// at `POST /admin/media` (initiate) time — the client's declared
  /// `sizeBytes`/`contentType` for the object it is about to `PUT` to the
  /// presigned URL. Both nullable with NO default, so every pre-existing row
  /// (created before this slice) keeps compiling and backfills to `null` —
  /// this additive migration changes no existing row's value.
  ///
  /// WHY THESE EXIST (and why not just re-check at completion time): the
  /// whole point of 11L-B3's hardened `complete-upload` verification is that
  /// the browser is not trusted. If the expected size/type were supplied on
  /// the COMPLETION call instead, a caller could upload a 10-byte file,
  /// declare 10 bytes at that same call, and the check would pass
  /// vacuously — completion would be verifying the client's claim against
  /// itself. Recording the expectation HERE, at initiate, server-side, means
  /// `completeUpload` instead compares R2's own `HeadObject` response
  /// against a value the completing caller cannot restate or influence.
  ///
  /// `null` on a row means "created before this slice" — completion falls
  /// back to an existence-only check for those rows (see
  /// `AdminMediaService.completeUpload`'s doc comment for the exact
  /// backward-compatibility rule). Every row `createUpload` creates AFTER
  /// this slice always sets both fields from the now-required
  /// `CreateMediaUploadDto.sizeBytes`/`contentType`, so a `null` expectation
  /// can never be used to bypass verification on a NEWLY created row.
  expectedSizeBytes             Int?
  expectedContentType           String?
  /// Slice 11N — HLS Processing Data Model + Queue Foundation (control
  /// workspace DECISIONS.md "2026-08-10 — Slice 11N APPROVED..." entry;
  /// architecture: `proposals/phase-11-hls-pipeline-proposal.md` §6-§8). The
  /// PROCESSING axis, deliberately INDEPENDENT of the editorial
  /// `lifecycleState` axis above (draft/ready/published/unpublished/failed
  /// tracks EDITORIAL state; this tracks HLS ENCODING progress — a
  /// `published` row can be mid-transcode, and a `failed` transcode does not
  /// touch `lifecycleState`).
  ///
  /// Nullable with NO default, so every pre-existing row (all 40+
  /// legacy/local rows with only `storageKey`, and every admin-created row
  /// from before this migration) keeps compiling and backfills to `null` —
  /// this additive migration changes no existing row's value. `null` means
  /// "no HLS processing pipeline has ever been requested for this row" — the
  /// PERMANENT state for a legacy/local row, which this slice never touches
  /// (nothing in 11N writes to a row unless `AdminMediaService.completeUpload`
  /// explicitly calls `TranscodeIntentService.requestProcessing` on it, and
  /// that only happens when `TRANSCODE_ENABLED=true`, which this slice never
  /// ships as `true`).
  ///
  /// App-layer validated values ONLY — NOT a Postgres enum, matching this
  /// schema's existing `Video.category`/`lifecycleState` plain-string
  /// precedent: `"queued" | "running" | "ready" | "failed"` (see
  /// `src/transcode/transcode.constants.ts`'s `PROCESSING_STATES`).
  /// `PROBING`/`TRANSCODING`/`PACKAGING`/`VERIFYING` are explicitly NOT
  /// states here (proposal §6: "their transition rules would be identical,
  /// so as states they'd be aesthetic") — that level of detail is a future,
  /// display-only `processingStep` column, deliberately NOT added by this
  /// slice (schema-minimality: 11N does not exercise it).
  ///
  /// This slice (11N) is the ONLY writer that exists today, and it only ever
  /// writes `"queued"` (`TranscodeIntentService.requestProcessing` and
  /// `TranscodeReconcilerService.reconcile`, which re-enqueues but never
  /// changes this column). `"running"`/`"ready"`/`"failed"` are reserved for
  /// the FFmpeg worker slice (11O+) that does not exist yet — no code path
  /// in this repository writes them today. `TranscodeIntentService
  /// .transitionIfVersion` is the generic CAS primitive a future worker MUST
  /// use to write them safely (see `processingVersion` below), but nothing
  /// calls it with any of those three values yet.
  processingState               String?
  /// Slice 11N: monotonic PER-ROW processing-generation counter — the
  /// compare-and-swap (CAS) token every current and future processing write
  /// must present unchanged before it is allowed to mutate `processingState`
  /// (`TranscodeIntentService.transitionIfVersion`, an `updateMany` guarded
  /// on `processingVersion: expectedVersion`; a stale/superseded version
  /// affects zero rows). Defaults to 0 so every pre-existing row (and every
  /// row created without specifying it) backfills to exactly `0` — this
  /// additive migration changes no existing row's value.
  ///
  /// Incremented atomically — `{ increment: 1 }` inside the SAME single
  /// Prisma `update` call that also sets `processingState = "queued"`
  /// (`TranscodeIntentService.requestProcessing`), never a separate
  /// read-then-write — so two concurrent `requestProcessing` calls against
  /// the same row race-safely land on two DISTINCT, consecutive versions
  /// (e.g. 1 then 2), never the same value twice. The resulting version
  /// becomes both the BullMQ job's dedupe identity
  /// (`jobId = "<videoId>:<processingVersion>"`, see
  /// `transcode.constants.ts#buildTranscodeJobId`) and the exact value
  /// `TranscodeReconcilerService.reconcile` re-reads fresh from this column
  /// before every re-enqueue attempt (never a version it cached earlier) —
  /// a duplicate/late worker attempt against a superseded generation can
  /// never silently overwrite a newer one.
  processingVersion             Int       @default(0)
  /// Slice 11P — Production Transcoding Lifecycle (control workspace
  /// DECISIONS.md "2026-08-10 — Slice 11P APPROVED..." entry; architecture:
  /// `proposals/phase-11-hls-pipeline-proposal.md` §6-§8). Every column added
  /// by this slice is additive/nullable/defaulted so no pre-existing row
  /// (including every legacy/local row and the 11N/11O-era rows that only
  /// ever wrote `processingState`/`processingVersion`) changes meaning —
  /// verified post-migration on both `short_drama_dev` and `short_drama_test`
  /// (11N row-safety precedent). Every field below is written EXCLUSIVELY by
  /// 11P code (`TranscodeIntentService`'s new CAS methods and
  /// `TranscodeJobProcessor`) — nothing in 11N/11O ever touched any of these.
  ///
  /// `hlsMasterKey`: the CONSUMER-VISIBLE pointer to the current, fully
  /// verified live HLS generation's master playlist object key (e.g.
  /// `"admin-media/<id>/hls/v3-a1-<uuid>/master.m3u8"`). Written ONLY by the
  /// single version-guarded promotion CAS
  /// (`TranscodeIntentService.promoteIfCurrent`) once every rendition exists,
  /// every playlist validates, and every artifact is HEAD-verified in R2 — a
  /// partial/failed generation can never reach this column (proposal §7,
  /// approval binding constraint 2/3). Never overwritten in place: a
  /// re-transcode writes a brand-new immutable prefix and only flips this
  /// pointer once THAT generation is fully verified, so a reader observing
  /// this column mid-flip always sees either the old, fully-intact
  /// generation or the new one — never a mix. `null` means "no HLS output has
  /// ever been promoted for this row" (every legacy row, and any HLS-pipeline
  /// row that has not yet completed its first successful transcode).
  hlsMasterKey                  String?
  /// `processingStep`: DISPLAY-ONLY operational progress detail within the
  /// `running` state (`"probing"`, a rung name like `"360p"`, `"packaging"`,
  /// `"uploading"`, `"verifying"`, `"poster"` — see
  /// `TranscodeJobProcessor`'s doc comment for the exact sequence). Never a
  /// distinct lifecycle state (proposal §6: "their transition rules would be
  /// identical, so as states they'd be aesthetic" — reaffirmed for 11P).
  /// Always `null` outside `running` — every CAS transition OUT of `running`
  /// (to `ready`, `failed`, or back to `queued` on retry) clears it in the
  /// SAME write, and `TranscodeIntentService.recordIntent` (completeUpload's
  /// new intent write) also explicitly nulls it, so a stale step from a
  /// prior attempt can never be read as if it were current.
  processingStep                String?
  /// `processingErrorCode`: a short, bounded, machine-stable, SECRET-FREE
  /// code for the most recent failure (e.g. `"SOURCE_MISSING"`,
  /// `"PROBE_FAILED"`, `"TRANSCODE_FAILED"`, `"HLS_PACKAGE_VALIDATION_FAILED"`,
  /// `"UPLOAD_VERIFICATION_FAILED"`, `"POSTER_GENERATION_FAILED"`,
  /// `"MAX_ATTEMPTS_EXCEEDED"`, `"STALE"` (janitor-detected stalled run)) —
  /// see `TranscodeJobProcessor`/`TranscodeJanitorService` for the full,
  /// closed set. Written only alongside a CAS transition to `failed`; cleared
  /// (`null`) by `recordIntent` on the next processing request, so a retried
  /// row never carries a stale error forward once it starts running again.
  /// Never a raw exception message/stack (that could embed an absolute
  /// filesystem path or another secret) — always one of the closed set above.
  processingErrorCode           String?
  /// `processingErrorMessage`: a short, bounded (never a raw stack trace or
  /// unredacted exception string — see `redactSensitiveText`), human-readable
  /// companion to `processingErrorCode`, surfaced by a future admin UI
  /// (11U). Same null/clear lifecycle as `processingErrorCode` above.
  processingErrorMessage        String?
  /// `processingAttempts`: monotonic per-GENERATION (i.e. reset to `0` by
  /// `recordIntent` on every new `requestProcessing` call, since a new
  /// `processingVersion` is a brand-new generation, not a retry of the old
  /// one) attempt counter, incremented by the SAME CAS write that claims
  /// `queued -> running`. Bounds retries at `TRANSCODE_MAX_ATTEMPTS`
  /// (default 3, `src/config/configuration.ts`) — `TranscodeJobProcessor`
  /// refuses to run FFmpeg at all once this would exceed the cap, CAS-failing
  /// the row immediately instead (`MAX_ATTEMPTS_EXCEEDED`). Defaults to `0`
  /// so every pre-existing row backfills to `0` — this additive migration
  /// changes no existing row's value.
  processingAttempts            Int       @default(0)
  /// `processingStartedAt`: set by the SAME CAS write that claims
  /// `queued -> running` for the CURRENT attempt — the basis for
  /// `TranscodeJanitorService`'s stale-running detection
  /// (`now() - processingStartedAt > TRANSCODE_STALLED_AFTER_MINUTES`) and
  /// for a future "queue wait" / "processing duration" observability metric
  /// (`processingCompletedAt - processingStartedAt`). Left in place (not
  /// cleared) once a row leaves `running`, so it always reflects "when the
  /// MOST RECENT attempt started" even after that attempt finishes — the
  /// next `recordIntent` (a brand-new generation) does not reset it either;
  /// only the next successful `queued -> running` claim overwrites it.
  processingStartedAt           DateTime?
  /// `processingCompletedAt`: set by BOTH terminal CAS transitions —
  /// `promoteIfCurrent` (success) and `failWithError`/the janitor's stale-run
  /// CAS (failure) — the paired telemetry timestamp for
  /// `processingStartedAt` above. `null` while a row has never reached a
  /// terminal outcome for its current attempt.
  processingCompletedAt         DateTime?
  /// `sourceWidth`/`sourceHeight`/`sourceDurationSeconds`/`sourceFps`:
  /// persisted `ffprobe` results for the CURRENT source object
  /// (`TranscodeJobProcessor`'s probing step, via the existing
  /// `HlsProbeClient`/`computeRenditionLadder` primitives from Slice 11O) —
  /// informational/telemetry only; nothing in this slice re-derives the
  /// rendition ladder from these persisted values on a later run (each run
  /// re-probes the source fresh, since the source object itself could
  /// theoretically change between attempts). `sourceFps` is `Float` (not
  /// `Int`) because real frame rates are frequently non-integer (e.g.
  /// `29.97`), matching `HlsSourceProbe.fps`'s existing shape
  /// (`src/transcode/hls/hls.types.ts`).
  sourceWidth                   Int?
  sourceHeight                  Int?
  sourceDurationSeconds         Int?
  sourceFps                     Float?
  /// `hlsRenditions`: the ACTUALLY-PRODUCED rendition summary for the
  /// CURRENT `hlsMasterKey` generation only — `[{name, width, height,
  /// bandwidth}]` (see `HlsRenditionSummary`,
  /// `src/transcode/transcode.types.ts`), written in the SAME promotion CAS
  /// as `hlsMasterKey` so the two always describe the same generation and can
  /// never disagree. `Json?` (not a separate table): this is a small,
  /// read-mostly, always-replaced-as-a-whole array with no independent query
  /// need of its own — matches this schema's existing `Json?` precedent
  /// (`AnalyticsEvent.properties`, `AuthAuditEvent.metadata`) rather than
  /// introducing a `Rendition` join table for a value that is only ever
  /// read/written as a single unit.
  hlsRenditions                 Json?
  /// `transcodeProfileVersion`: a plain string tag (e.g. `"ladder-v1"`,
  /// matching `Video.category`/`processingState`'s existing plain-string —
  /// NOT Postgres-enum — precedent) identifying which rendition-ladder
  /// profile (`src/transcode/hls/hls-profile.constants.ts`'s `RUNG_PROFILES`)
  /// produced the CURRENT `hlsMasterKey` generation, written in the SAME
  /// promotion CAS. Lets a future ladder-table revision (e.g. `"ladder-v2"`)
  /// distinguish already-transcoded generations from ones that predate it,
  /// without needing to re-probe or guess.
  transcodeProfileVersion       String?

  @@index([seriesId])
  @@index([sortOrder])
  @@index([lifecycleState])
  /// Slice 11N: `TranscodeReconcilerService.reconcile` filters on
  /// `processingState = "queued"` for every sweep — indexed for the same
  /// reason `lifecycleState` already is above.
  @@index([processingState])
}

// Phase 11, work unit 11E-4: additive series metadata. `id` intentionally
// has NO `@default` — it is the existing plain-string `seriesId` convention
// already used by `Video.seriesId` above (e.g. "series-104"), so a `Series`
// row is created with a client-provided id that ANNOTATES an existing
// grouping rather than generating a new one. There is deliberately NO
// relation/FK to `Video` here (`Video.seriesId` stays a plain, unconstrained
// `String`, matching its existing doc comment and the
// `UserVideoInteraction.videoId`/`WatchProgress.seriesId` precedent of
// keeping cross-entity references at the application level, not the DB
// level) — this table is purely optional metadata (display title, cover
// image, manual ordering) about a `seriesId` value that may or may not have
// any `Video` rows yet. Creating, updating, listing, or never creating a
// `Series` row has zero effect on `Video` rows or the public `/videos/feed`
// grouping (still computed client-side from `Video.seriesId`, unchanged by
// this work unit). `sortOrder` defaults to 0, independent of and unrelated
// to `Video.sortOrder` (a different table, a different ordering concern).
model Series {
  id                   String    @id
  title                String
  coverImageKey        String?
  sortOrder            Int       @default(0)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  /// Phase 11, work unit 11F-1: safe (soft) archive — the PRIMARY "delete"
  /// action for a `Series` row. Nullable with NO default, so every
  /// pre-existing row (and every caller that creates/updates a `Series`
  /// without specifying it) keeps compiling and backfills to `null`
  /// ("active, not archived") — this additive migration changes no existing
  /// row's value. Non-null means "archived at this timestamp"; archiving
  /// and unarchiving only ever set/clear this column (no data loss, fully
  /// reversible) via `POST /admin/series/:id/archive`/`:id/unarchive`.
  /// `GET /admin/series` excludes archived rows by default and only
  /// includes them when `includeArchived=true` is explicitly passed. This
  /// is distinct from the guarded HARD `DELETE /admin/series/:id`, which
  /// actually removes the row and is refused (409) whenever the series
  /// still has published episodes.
  archivedAt           DateTime?
  /// Work unit "SERIES COVER UPLOAD BACKEND CONTRACT" fix cycle 1 (2026-08-15,
  /// closing the reviewer-reproduced stale/replayed-`complete` HIGH finding):
  /// the durable, server-side record of the ONE object key `createCoverUpload`
  /// most recently minted for this series — mirrors the 11P
  /// `TranscodeIntentService`/`processingVersion` precedent of persisting
  /// upload/processing INTENT so a later completion step can be verified
  /// against a durable expectation, not trusted on its shape alone. Nullable
  /// with NO default, so every pre-existing row (all 4 seeded `Series` rows,
  /// and any row created before this migration) keeps compiling and
  /// backfills to `null` — this additive migration changes no existing row's
  /// value, and does NOT retroactively invent a pending key for a series that
  /// never had an in-flight upload.
  ///
  /// Written by exactly two places:
  /// - `SeriesService.createCoverUpload` sets it to the freshly minted key on
  ///   EVERY presign call, overwriting any prior pending value — "latest mint
  ///   wins". This does NOT reintroduce the "no `coverImageKey` persistence on
  ///   presign" criterion this work unit's original acceptance criterion 1
  ///   established: `coverImageKey` (the PUBLIC, served cover) and the public
  ///   `coverUrl` derived from it are completely untouched by this write —
  ///   `pendingCoverImageKey` is purely private upload-intent bookkeeping, an
  ///   internal column no read DTO (`SeriesDto`/`SeriesWithCoverDto`) exposes.
  /// - `SeriesService.completeCoverUpload` clears it back to `null` the
  ///   instant a matching key is successfully verified and promoted to
  ///   `coverImageKey`.
  /// - `SeriesService.update` ALSO clears it whenever `coverImageKey` is
  ///   explicitly set to `null` via `PATCH /admin/series/:id` — an explicit
  ///   clear invalidates any upload that was still in flight, so a
  ///   stale/replayed `complete` for that abandoned key has nothing left to
  ///   match.
  ///
  /// `completeCoverUpload` accepts `dto.key` ONLY when it equals this column
  /// (the normal, in-flight-upload path) OR equals the row's CURRENT
  /// `coverImageKey` (an idempotent re-complete of an already-persisted
  /// cover, a harmless no-op). Any other well-formed
  /// (`isValidSeriesCoverObjectKey`-passing) key is neither the row's current
  /// intent nor its current live cover — it is a SUPERSEDED or already-cleared
  /// key from an earlier generation — and is rejected with `409
  /// SERIES_COVER_KEY_SUPERSEDED` rather than silently re-applied. This is
  /// what closes the reviewer's two reproduced repros: replaying `complete`
  /// with an old, already-superseded key can never again revert a
  /// since-replaced cover, and can never again "un-clear" a cover that was
  /// explicitly PATCHed to `null`.
  ///
  /// Slice "SERIES COVER UPLOAD CONCURRENCY / TOCTOU HARDENING" (2026-08-18):
  /// this column is ALSO the compare-and-set predicate of
  /// `completeCoverUpload`'s FINAL write. That write is a conditional
  /// `updateManyAndReturn` whose `WHERE` clause requires
  /// `pendingCoverImageKey` to STILL equal the completing key at the exact
  /// moment the row is updated — matching 0 rows (someone removed the cover
  /// or minted a replacement intent while this completion was verifying the
  /// object in storage) means the completion writes NOTHING and is answered
  /// `409 SERIES_COVER_KEY_SUPERSEDED`. The pre-storage check described
  /// above compares against a row read BEFORE a network HEAD round-trip, so
  /// it alone cannot decide currency at write time; this column being part
  /// of the write predicate is what makes "newest intent wins" a database
  /// guarantee rather than a check-then-act hope. Same conditional-write CAS
  /// shape `Session.revokedAt` already uses in `AuthService.refresh`/
  /// `AuthService.revokeSession`.
  pendingCoverImageKey String?

  @@index([sortOrder])
}

// Phase 9, work unit 9-B1: per-user Like/Save state for a video, mirroring
// mobile's local `VideoInteraction` shape (`video-interactions.tsx`) exactly
// so the sync layer added in 9-B2/mobile is a near-direct mapping. `videoId`
// is intentionally a plain string, NOT a `@relation` FK to `Video.id` —
// consistent with how `Video.seriesId` above is already a plain string with
// no relation, and it keeps referential-integrity enforcement (does this
// video exist?) as an explicit application-level check in the 9-B2 endpoint
// layer rather than a DB constraint. That is deliberate: a like/save action
// failing loudly with a DB-level foreign key violation is a worse failure
// mode for this MVP than the endpoint returning a clear
// `AppException`/404-style error after checking `Video` existence itself,
// and it avoids having to pick an `onDelete` cascade/restrict policy for
// `Video` deletion (no delete-video endpoint exists yet) as a side effect of
// this schema-only work unit.
model UserVideoInteraction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  isLiked   Boolean  @default(false)
  isSaved   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
}

// Phase 9, work unit 9-B1: per-user, per-series watch progress, mirroring
// mobile's local `SeriesProgress` shape (`series-progress.tsx`) exactly.
// `seriesId` and `lastWatchedVideoId` are plain strings for the same reason
// as `UserVideoInteraction.videoId` above (no DB-level FK to `Video`;
// existence is an application-level concern for the 9-B2 endpoint).
// `positionSeconds`/`durationSeconds` use `Int`/`Int?` for consistency with
// the existing `Video.durationSeconds Int?` convention in this schema
// (seconds-as-integer), even though mobile's local `SeriesProgress` type
// uses a plain `number` that would also fit a `Float`.
model WatchProgress {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId                 String
  lastWatchedVideoId       String
  lastWatchedEpisodeNumber Int
  positionSeconds          Int
  durationSeconds          Int?
  updatedAt                DateTime @updatedAt

  @@unique([userId, seriesId])
  @@index([userId])
}

// Phase 10, work unit 10-B1: account-wide premium entitlement (single tier,
// not per-series/per-episode — matches how `FREE_EPISODE_LIMIT` already
// works client-side today; see DECISIONS.md "Phase 10 approved..." entry,
// default decision 5). `revokedAt` mirrors `Session.revokedAt`'s existing
// nullable-timestamp revocation pattern (soft-revoke, not delete, so history
// stays auditable) rather than introducing a new convention.
// `expiresAt`/`revokedAt` are independently nullable: `expiresAt IS NULL`
// means "no expiration," `revokedAt IS NULL` means "not revoked" — a row is
// currently active only when both are satisfied
// (`revokedAt IS NULL AND (expiresAt IS NULL OR expiresAt > now())`).
// `source`/`tier` are plain strings, not enums, matching `Video.category`'s
// existing precedent — no real payment source exists yet ("dev-grant" is the
// only value produced by this phase), and using a string avoids a schema
// migration when a real source is added later.
model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      String
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  source    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

// Phase 11, work unit 11-B2: self-hosted analytics/crash-event ingestion
// (see DECISIONS.md "Phase 11 approved..." — default decisions 1/2/4).
// Unlike every other user-owned model in this schema (which cascade-delete
// with the User), `userId` here is nullable with ON DELETE SET NULL:
// deleting an account unlinks the user's identity from their events without
// destroying the aggregate data — the privacy-preserving middle ground
// recorded in DECISIONS.md. `properties` is validated against a per-event
// server-side allowlist in AnalyticsService before ever reaching this
// table; nothing outside that allowlist is persisted.
model AnalyticsEvent {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventName       String
  properties      Json
  platform        String
  clientTimestamp DateTime
  receivedAt      DateTime @default(now())

  @@index([eventName])
  @@index([userId])
  @@index([receivedAt])
}

// Phase 12, work unit 12A-B3: operational SECURITY audit log (DECISIONS.md
// "Phase 12 ... approved..." entry, decision 6, plus the "Additional binding
// requirements" section). Deliberately a SEPARATE model from `AnalyticsEvent`
// above — different purpose (operational security investigation, e.g. "was
// this account brute-forced / did a stolen refresh token get replayed"),
// different retention/access story, never merged into the product-analytics
// pipeline. Written exclusively by `AuthAuditService.emit` (see that file's
// doc comment), which enforces every one of the constraints this schema
// relies on before a row is ever created:
//   - `event` is restricted server-side to an allowlisted
//     `AuthAuditEventName` union (login_success, login_failed,
//     account_locked, register_success, refresh_reuse_detected, ...) — never
//     an arbitrary caller-supplied string.
//   - `ipHash` is an HMAC-SHA256 digest of the client IP, keyed with a
//     DEDICATED secret (`AUTH_AUDIT_IP_HASH_SECRET`, distinct from the JWT
//     access/refresh signing secrets) — the raw IP address is never computed
//     into this column or persisted anywhere else on this row.
//   - `userAgent` is truncated and control-character-sanitized before
//     storage, never persisted verbatim/unbounded.
//   - `metadata` is validated against a per-event allowlist (mirroring the
//     existing `AnalyticsEvent.properties` allowlist precedent) — no
//     password, token, secret, raw email, or raw IP value can ever reach
//     this column, regardless of what a caller passes to `emit`.
// `userId` is nullable with `onDelete: SetNull` (see `User.authAuditEvents`
// above) rather than `Cascade`, so a deleted account's security history
// survives instead of disappearing — the opposite tradeoff from
// `Session`/`AccountLockout`, which intentionally DO cascade-delete, because
// this table exists specifically to be read AFTER something has already gone
// wrong with an account, which can include its own deletion. `SetNull` by
// itself nulls only `userId`; it does NOT anonymize a surviving row, because
// `ipHash` is a globally stable, unsalted, unrotated HMAC that would still
// correlate the row to any other live session/account sharing that IP —
// calling `SetNull` alone "anonymized" would be exactly the overstated claim
// DECISIONS.md's 2026-07-30 decision 1 forbids. Phase 12, work unit 12E-B1
// closes that gap with an explicit pre-delete scrub (inside the same
// transaction, before the `User` row is deleted) that additionally nulls
// `ipHash`/`userAgent`/`metadata`, leaving only `event`/`createdAt` — see
// `AuthService.deleteAccount`'s doc comment for the full mechanism.
model AuthAuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String
  ipHash    String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([event])
  @@index([createdAt])
}

// Phase 12, work unit 12B-B3: `POST /auth/password-reset/request` /
// `POST /auth/password-reset/confirm` (DECISIONS.md "Phase 12 ...
// approved..." entry, decision 3). A row is created only once a
// `password-reset/request` call resolves to a REAL existing `User` — a
// nonexistent email never creates a row here, matching the exact same
// no-enumeration-surface precedent `AccountLockout`'s schema doc comment
// above already establishes for this codebase.
//
// `tokenHash` (NOT the raw token) is the only thing ever persisted — the
// raw, high-entropy opaque token is returned to the caller (API response,
// gated by `DEV_TOOLS_ENABLED`/`NODE_ENV`; see `AuthService
// .requestPasswordReset`) and otherwise never stored, matching
// `Session.refreshTokenHash`'s existing "hash of a bearer secret, `@unique`,
// never the plaintext" precedent exactly. It is HMAC-SHA256 keyed with
// `jwtRefreshSecret` (see `AuthService.hashPasswordResetToken`'s doc comment
// for why this reuses that secret rather than minting a fourth one) — this
// is deliberately NOT the same value as `Session.refreshTokenHash` for the
// same raw bytes would be (different tokens, different purposes), it is the
// same HASHING KEY.
//
// `usedAt` (nullable, set exactly once) enforces single-use: a token that
// has already been consumed by a successful confirm can never be reused,
// even if the raw value leaks afterward (e.g. via a browser history/email
// client). `expiresAt` bounds the exposure window independently of use.
// Both `usedAt IS NULL` and `expiresAt > now()` must hold for a presented
// token to be accepted by `AuthService.confirmPasswordReset` — see that
// method's doc comment for the single-statement, race-safe claim mechanism
// (a conditional `updateMany` keyed on `usedAt: null`, mirroring
// `AuthService.revokeSession`'s existing CAS-on-one-row pattern) that
// prevents two concurrent confirms of the same still-valid token from both
// succeeding.
//
// `onDelete: Cascade` (not `SetNull`, unlike `AuthAuditEvent` above): an
// outstanding reset token for an account that no longer exists is useless
// dead weight, not an audit trail worth preserving — this mirrors
// `Session`/`AccountLockout`'s existing cascade precedent, not
// `AuthAuditEvent`'s survive-and-get-scrubbed precedent.
// Work unit "MIDTRANS PAYMENT BACKEND FOUNDATION": the authoritative,
// server-owned record of one checkout attempt against the Midtrans Snap
// hosted-payment flow. This row — never a webhook payload, never a redirect
// query parameter, never anything a client sends — is the single source of
// truth for what was ordered, what it costs, and whether it has been paid.
//
// `status` is a plain `String` (NOT a Postgres enum, matching the
// `Video.lifecycleState`/`Entitlement.tier` precedent), app-layer validated
// against the closed `PaymentOrderStatus` union in
// `src/payments/payment-state.constants.ts` (CREATED | PENDING | PAID |
// FAILED | EXPIRED | CANCELED | REFUNDED). Every transition is applied via a
// guarded `updateMany` CAS whose `where` clause names the exact set of
// states the transition is allowed FROM (the `TranscodeIntentService`
// `processingState` idiom) — a duplicate or out-of-order webhook matches 0
// rows and writes nothing, which is what makes webhook processing idempotent
// and monotonic at the DATABASE level rather than as a check-then-act hope.
//
// `providerOrderId` is the server-GENERATED id sent to Midtrans as
// `transaction_details.order_id` (`sd-<uuid>`, well within Midtrans'
// String(50) / [-_~.] contract) — a client never chooses or supplies it.
// `@unique` both enforces the Midtrans "single use per merchant" order-id
// contract and gives webhook lookups an index.
//
// `openOrderKey` is the checkout idempotency anchor: `"<userId>:<planId>"`
// while the order is open (CREATED/PENDING), `NULL` once it reaches any
// terminal state (every terminal CAS clears it in the same write). The
// partial-uniqueness this needs ("at most one OPEN order per user+plan") is
// expressed as a plain nullable `@unique` — Postgres allows any number of
// NULLs in a unique index — so a retried/double-tapped checkout finds and
// returns the existing open order instead of silently creating (and
// potentially charging) a second one, and a concurrent duplicate INSERT
// loses with a unique violation instead of racing.
//
// `entitlementId` (nullable, `@unique`) records WHICH `Entitlement` row this
// order's success produced — written in the SAME transaction as the
// PAID transition, so "order says PAID" and "premium was granted for it" can
// never disagree. Plain string reference (no `@relation`), matching the
// `Video.seriesId`/`UserVideoInteraction.videoId` app-level-reference
// precedent. `amountIdr` is the server-computed authoritative charge in
// whole rupiah (Midtrans: IDR only, no decimals); `entitlementDurationDays`
// snapshots the purchased premium duration AT CHECKOUT TIME so a later
// catalog change can never retroactively alter what an already-paid order
// grants. `snapToken`/`checkoutUrl` are the Midtrans-issued hosted-payment
// references (client-facing by design — not secrets, but never logged).
// No raw provider payload is persisted anywhere on this row (deliberate,
// see `PaymentNotificationService`'s doc comment): only normalized
// identifiers/status fields — so no `signature_key`, Server Key material,
// or unbounded JSON can ever leak through a DB dump or API response.
model PaymentOrder {
  id                        String    @id @default(cuid())
  userId                    String?
  user                      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  provider                  String
  providerOrderId           String    @unique
  planId                    String
  amountIdr                 Int
  currency                  String
  status                    String
  openOrderKey              String?   @unique
  snapToken                 String?
  checkoutUrl               String?
  checkoutExpiresAt         DateTime?
  providerTransactionId     String?
  providerTransactionStatus String?
  providerFraudStatus       String?
  entitlementDurationDays   Int
  paidAt                    DateTime?
  entitlementId             String?   @unique
  failureCode               String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// PHASE 10B — PRODUCTION IDENTITY PROVIDERS. The provider-NEUTRAL binding
// between one external authentication method and one internal Short Drama
// `User`. Deliberately a separate table rather than `googleSubject` /
// `whatsappPhone` columns bolted onto `User`: a per-provider column set
// makes every new provider a `User` migration, makes "which methods can
// this account actually sign in with" an ad-hoc OR across nullable columns,
// and gives the database no single place to enforce "one external identity
// belongs to at most one account" — the constraint that account-takeover
// protection ultimately rests on.
//
// `provider` is a plain `String` (NOT a Postgres enum), matching the
// `Video.lifecycleState` / `Entitlement.tier` / `PaymentOrder.status`
// precedent this schema already sets for every closed set it stores.
// App-layer validated against the closed `AuthProvider` union in
// `src/auth/identity/auth-identity.constants.ts` (`email` | `google` |
// `whatsapp`) — adding a fourth provider stays a code change, not a
// `CREATE TYPE`/`ALTER TYPE` migration.
//
// `providerSubject` is the provider's own STABLE, AUTHORITATIVE identifier
// for the human — never a display name, never anything the client chose:
//   - `google`   — the OIDC `sub` claim from a SERVER-VERIFIED ID token.
//                  Deliberately NOT the email: Google documents `sub` as
//                  the only stable per-account identifier, an email can be
//                  changed or (on Workspace domains) reassigned to a
//                  different human, and treating a claimed email as an
//                  identity key is precisely the account-takeover shape
//                  this model exists to prevent.
//   - `whatsapp` — the E.164 phone number proved by a verified OTP.
//   - `email`    — the lowercased email address whose password lives in
//                  `User.passwordHash`.
//
// `@@unique([provider, providerSubject])` is THE security constraint, and
// enforces two of the three required prohibitions at the DATABASE level
// rather than as a check-then-act hope: one Google `sub` can exist at most
// once across the whole table (no duplicate Google subject), one normalized
// phone can exist at most once (no duplicate WhatsApp identity), and since
// a row has exactly one `userId`, an already-bound identity can never also
// be bound to a second account — a concurrent second binding loses with a
// `P2002` unique violation instead of racing. `@@unique([userId, provider])`
// enforces the third: at most ONE identity per provider per account, so
// "unlink Google" is unambiguous and an account cannot silently accumulate
// several Google subjects (each of which would be an independent way in).
//
// `normalizedIdentifier` is the human-readable, normalized value BEHIND the
// subject — the lowercased email for `email`/`google`, the E.164 phone for
// `whatsapp` — kept for operator legibility and for the account-collision
// check that produces `AUTH_ACCOUNT_LINK_REQUIRED`. It is NULLABLE and
// deliberately NOT unique: a Google account whose `email_verified` claim is
// false stores `NULL` here (an unverified email is not evidence of
// anything), and making it unique would let an unrelated, unverified
// third-party claim block a real account.
//
// `verifiedAt` records when the provider's ownership proof was accepted:
// the OTP verification time for `whatsapp`, the ID-token verification time
// for `google`, and `NULL` for `email` — this app has never implemented
// email-address verification, so claiming a verification time for a
// backfilled email identity would be a fabricated audit record. Nothing
// authorizes off this column today; it is evidence, not a gate.
model AuthIdentity {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider             String
  providerSubject      String
  normalizedIdentifier String?
  createdAt            DateTime  @default(now())
  verifiedAt           DateTime?

  @@unique([provider, providerSubject])
  @@unique([userId, provider])
  @@index([userId])
}

// PHASE 10B — one outstanding WhatsApp OTP challenge. Deliberately NOT
// linked to a `User` (no `userId`, no foreign key): an OTP request is made
// for a PHONE NUMBER, and at request time the server does not know — and
// must not be made to reveal — whether that number belongs to an existing
// account. A nullable FK would have been a second, quieter enumeration
// surface for exactly the thing `POST /auth/whatsapp/otp/request`'s
// always-`202` contract exists to hide.
//
// `codeHash` (NEVER the code) is the only representation of the OTP that is
// ever persisted, following `Session.refreshTokenHash` /
// `PasswordResetToken.tokenHash`'s established "hash of a bearer secret,
// never the plaintext" precedent. It is HMAC-SHA256 keyed with
// `JWT_REFRESH_SECRET` over a fixed domain tag PLUS THE PHONE NUMBER (see
// `AuthIdentityService.hashOtpCode`) — the phone binding matters here in a
// way it does not for the two 256-bit tokens above, because a 6-digit code
// has only 10^6 possible values: without it, an attacker who observed one
// row could recognize the same code for a different phone, and the entire
// hash space could be precomputed once. It is deliberately NOT bcrypt: the
// brute-force defense for a low-entropy code is the ATTEMPT LIMIT plus the
// short expiry (both enforced below), not hash slowness, and a slow hash on
// this path would only make the verify endpoint a CPU-exhaustion target.
//
// `attemptCount` + `consumedAt` are what make a challenge single-use and
// non-brute-forceable, and both are only ever mutated by SINGLE-STATEMENT
// conditional `updateMany` CAS writes (`AuthIdentityService.verifyOtp`) —
// never inside a multi-statement transaction. That is a deliberate,
// load-bearing choice: see the "CANONICAL AUTH LOCK ORDER" block in
// `src/auth/auth.service.ts` — a single-statement auto-commit write can be
// blocked and can block, but can never hold a lock on one table while
// waiting on another, so this table can never supply an edge to a deadlock
// cycle even though it is touched immediately before the account-scoped
// transaction that issues the session.
//
// `ipHash` is the same HMAC-SHA256-of-client-IP (`hashIp`, keyed with
// `AUTH_AUDIT_IP_HASH_SECRET`) already stored on `Session`/`AuthAuditEvent`
// — never a raw IP — and exists solely to bound per-IP OTP request abuse.
//
// Rows are pruned opportunistically by `AuthIdentityService.requestOtp`
// once older than `OTP_CHALLENGE_RETENTION_MS`, so a phone number (PII for
// a person who may not even have an account here) does not linger
// indefinitely. There is no janitor job to schedule and no cascade to rely
// on, because there is no owning row to cascade from.
model PhoneOtpChallenge {
  id           String    @id @default(cuid())
  phoneE164    String
  /// PHASE 10B, fix cycle 1 (Reviewer B, finding 1) — the DATABASE-ENFORCED
  /// "at most ONE live challenge per phone number" invariant.
  ///
  /// Equal to `phoneE164` while the challenge is live, and `NULL` the moment
  /// it is consumed (every consume path sets both columns in the same
  /// write). Because Postgres permits any number of NULLs in a unique index,
  /// a plain nullable `@unique` expresses exactly the partial uniqueness this
  /// needs — the identical mechanism, for the identical reason, as
  /// `PaymentOrder.openOrderKey` above ("at most one OPEN order per
  /// user+plan"), and expressible in this schema file so `prisma db push`
  /// and `prisma migrate deploy` produce the same database.
  ///
  /// WHY IT IS REQUIRED, and why application-level reconciliation was not
  /// enough. Admission control was originally "INSERT, then re-read and
  /// decide who won". Under READ COMMITTED a caller's SELECT cannot see a
  /// concurrent INSERT that has not yet committed, so two callers could each
  /// conclude they had won, and their two follow-up "retire the other
  /// challenge" writes then CROSSED — leaving the number with the older code
  /// live, or with NO live code at all despite messages having been
  /// delivered. That is a repeatable denial of WhatsApp sign-in for a
  /// targeted number, and it reproduced under real load: a full parallel
  /// test run left a number with zero live challenges after an eight-request
  /// burst.
  ///
  /// With this column the question is not re-derived in application code at
  /// all. A second live INSERT for the same number simply loses to the unique
  /// index (`P2002`), atomically, at any isolation level, and is answered
  /// `OTP_RESEND_COOLDOWN`. Exactly one live challenge per number is now a
  /// property of the schema rather than of an interleaving.
  liveKey      String?   @unique
  codeHash     String
  expiresAt    DateTime
  attemptCount Int       @default(0)
  consumedAt   DateTime?
  createdAt    DateTime  @default(now())
  ipHash       String?

  @@index([phoneE164, createdAt])
  @@index([expiresAt])
}

// ===========================================================================
// REWARDS — work unit "REWARDS BACKEND FOUNDATION"
// ===========================================================================
//
// THE ONE INVARIANT THIS SCHEMA EXISTS TO ENFORCE:
//
//     A balance is a PROJECTION OF A LEDGER, never a stored number that
//     code is free to overwrite.
//
// (Mobile `docs/rewards-domain-contract.md` §1.) The failure mode being
// designed out is `user.points = user.points + 50` — a bare mutable counter
// that cannot answer where points came from, whether a reward was already
// paid, whether a retry double-paid, or how to reverse any of it.
//
// So: `RewardLedgerEntry` is append-only and is the source of truth.
// `RewardWallet.balancePoints` is a derived cache maintained by the SAME
// transaction that appends the entry. If the two ever disagree, the ledger
// wins and the wallet is rebuilt by summing it — which is possible at any
// time precisely because no entry is ever updated or deleted.

/// Read-optimised projection over `RewardLedgerEntry`. One row per user,
/// created lazily on first read/mutation (`RewardsWalletService.ensureWallet`).
///
/// `balancePoints` and `lifetimeEarnedPoints` are guarded by Postgres CHECK
/// constraints (`balancePoints >= 0`, `lifetimeEarnedPoints >= 0`) added in
/// this model's migration — Prisma has no schema syntax for CHECK, so they
/// live in the migration SQL. They are a LAST-RESORT backstop, not the
/// primary control: `RewardsWalletService.appendEntry` refuses an
/// overdrawing debit in application code with a clean
/// `INSUFFICIENT_REWARD_POINTS` error. The constraints exist so that if a
/// future writer ever forgets that check, the database refuses the write
/// instead of silently minting a negative balance.
///
/// `version` is an optimistic-concurrency counter, incremented on every
/// mutation. It is NOT the concurrency control (a `SELECT ... FOR UPDATE`
/// row lock is — see `appendEntry`); it is an observable audit signal, and
/// it is surfaced to the client so a stale snapshot is detectable.
model RewardWallet {
  id                   String              @id @default(cuid())
  userId               String              @unique
  user                 User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  balancePoints        Int                 @default(0)
  lifetimeEarnedPoints Int                 @default(0)
  version              Int                 @default(0)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  ledgerEntries        RewardLedgerEntry[]

  @@index([userId])
}

/// APPEND-ONLY. No updates, no deletes — a correction is a new compensating
/// entry (`REVERSAL`), never an edit. Nothing in this codebase issues an
/// `update` or `delete` against this table, and `rewards-wallet.service.spec.ts`
/// asserts a replayed action adds no second row rather than mutating one.
///
/// `idempotencyKey` IS THE ANTI-DOUBLE-PAY CONTROL. Unique per user, enforced
/// by a database constraint rather than an application-level "check then
/// insert" — that check-then-act races under concurrency and WILL double-pay
/// (mobile contract §4, "Idempotency"). Two concurrent identical claims both
/// attempt the insert; Postgres admits exactly one and the loser gets `P2002`,
/// which `appendEntry` converts into a replay of the winner's result. The key
/// is composed server-side for server-decided actions — a daily check-in is
/// keyed `DAILY_CHECK_IN:<periodKey>`, so a client cannot obtain a second
/// payout for the same calendar day by varying a key it supplies.
///
/// `balanceAfter` snapshots the projection immediately after this entry, so a
/// statement view renders without a running sum and an auditor can spot a
/// divergence between ledger and wallet by inspecting one row.
///
/// `deltaPoints` is signed and never zero (CHECK constraint in the migration):
/// a zero-delta entry would be an audit record of nothing having happened,
/// which belongs in a log, not in a ledger.
model RewardLedgerEntry {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletId       String
  wallet         RewardWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  deltaPoints    Int
  reason         String
  sourceType     String
  sourceId       String?
  idempotencyKey String
  balanceAfter   Int
  metadata       Json?
  createdAt      DateTime     @default(now())

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([walletId])
  @@index([reason])
}

/// Per-user daily check-in state. One row per user, updated in place — this
/// is DERIVED state (like `RewardWallet`), not history: the immutable history
/// of which days were claimed lives in the `DAILY_CHECK_IN` ledger entries,
/// whose `idempotencyKey` carries the period key. That is why the mobile
/// contract's proposed `checkInDates` array is absent here: it would be a
/// second, drift-prone copy of what the ledger already records exactly.
///
/// `lastCheckInDate` is a `YYYY-MM-DD` CALENDAR DATE in the service timezone,
/// stored as `String` and NOT as a `DateTime` — a reward day is a calendar
/// date in one pinned zone, not an instant, and a `DateTime` column would
/// silently mean a different 24 hours depending on which code path last wrote
/// it. See `reward-period.util.ts` for the full reasoning.
model RewardCheckIn {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreakDays Int       @default(0)
  longestStreakDays Int       @default(0)
  totalCheckInDays  Int       @default(0)
  lastCheckInDate   String?
  lastCheckInAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
}

/// The record of converting points into premium time. Distinct from the
/// ledger entry it produces: a redemption is an ACTION with an outcome that
/// can fail, while the ledger entry is the immutable financial fact of the
/// debit. Keeping them separate means a failed redemption leaves an audit
/// trail without moving any points (mobile contract §2, `RewardClaim`).
///
/// `costPoints`/`grantsDays` are SNAPSHOTTED from the catalog at redemption
/// time, so retuning `REWARD_REDEMPTION_OFFERS` never rewrites history.
///
/// `ledgerEntryId` and `entitlementId` are both `@unique`: each debit funds
/// at most one redemption and each redemption grants at most one entitlement,
/// so a double-grant is refused by the database and not merely by a code path
/// — the same discipline `PaymentOrder.entitlementId` already uses.
///
/// `idempotencyKey` is CLIENT-supplied here (unlike check-in, whose key the
/// server derives): redeeming the same offer twice is a legitimate action, so
/// the client is the only party that knows whether a second request is a new
/// purchase or a retry of the first.
model RewardRedemption {
  id                   String    @id @default(cuid())
  userId               String
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerId              String
  costPoints           Int
  grantsDays           Int
  status               String
  idempotencyKey       String
  ledgerEntryId        String?   @unique
  entitlementId        String?   @unique
  entitlementExpiresAt DateTime?
  failureReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status])
}
