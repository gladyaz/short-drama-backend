// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                 @id @default(cuid())
  email             String                 @unique
  passwordHash      String
  displayName       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  sessions          Session[]
  videoInteractions UserVideoInteraction[]
  watchProgress     WatchProgress[]
  entitlements      Entitlement[]
  analyticsEvents   AnalyticsEvent[]
  /// Phase 11, work unit 11B-2: authorizes the admin-guarded `/admin/media`
  /// API (11B-3). Plain `String` (not a Postgres enum), matching the
  /// existing `Video.category`/`Entitlement.tier` precedent — no second
  /// role exists yet, and a string avoids a schema migration if one is
  /// added later. Defaults to `"user"` so every pre-existing account (and
  /// every caller creating a `User` without specifying it, e.g.
  /// `AuthService.register`) is non-admin by default; becoming an admin is
  /// an explicit, separate action (`AdminGuard`'s DEV-ONLY grant route,
  /// gated by the existing `DEV_TOOLS_ENABLED`/`DevToolsGuard` precedent —
  /// there is no real admin-provisioning flow yet).
  role              String                 @default("user")
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String    @unique
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
}

// Phase 8, work unit 8-B4: flat mirror of `VideoRecord`
// (src/videos/video.types.ts). `id` intentionally has no @default — the
// existing 40 records carry meaningful, pre-assigned ids (e.g.
// "video-104-01") that must be preserved exactly via the seed script, not
// regenerated. `seriesId` is a plain string, not a relation: there is no
// separate Series entity today (episodes are grouped client-side from the
// flat feed response), and introducing one is out of scope for this work
// unit.
model Video {
  id                            String  @id
  seriesId                      String
  title                         String
  episodeNumber                 Int
  channelName                   String
  caption                       String
  category                      String
  storageKey                    String
  sourceLanguage                String
  hasEmbeddedIndonesianSubtitle Boolean
  likeCount                     Int
  durationSeconds               Int?
  width                         Int?
  height                        Int?
  /// Work unit 8-B4 fix cycle 1: explicit, deterministic feed ordering.
  /// `seriesId`/`episodeNumber` ordering does NOT reproduce the original
  /// curated order in `videos.data.ts` (series-104 first, then series-010,
  /// series-101, series-105 — not alphabetical by seriesId), so a plain
  /// column carrying that intent is used instead. Defaults to 0 so existing
  /// callers (e.g. `seed.ts`, `videos.service.spec.ts`) that create/update
  /// `Video` rows without specifying it keep compiling; the additive
  /// migration backfills the correct value for the 40 pre-existing rows.
  sortOrder                     Int     @default(0)
  /// Phase 11, work unit 11A-2: object-storage fields for the upcoming
  /// R2/S3-compatible media pipeline (11B/11D), added alongside the existing
  /// `storageKey` (local `STORAGE_ROOT`-relative path — untouched, still the
  /// sole field `VideosController#streamVideo` resolves against; see
  /// DECISIONS.md "Phase 11 runbook reviewed..." entry: this slice does NOT
  /// cut streaming over to object storage, that is 11A-3, out of scope).
  /// All four are nullable with no default, so every existing row (and every
  /// caller that creates/updates a `Video` without them, e.g. `seed.ts`)
  /// keeps compiling and importing unchanged; they are populated only once a
  /// video is actually uploaded to object storage via the 11B-3 admin API.
  /// `objectStorageVariant` is a free-form label (e.g. "source", "720p")
  /// rather than a separate join table — no real transcoding/rendition
  /// pipeline exists yet, and a plain string avoids a schema migration when
  /// one is added later (matching the existing `Video.category` precedent).
  objectStorageKey              String?
  objectStorageVariant          String?
  coverImageKey                 String?
  thumbnailImageKey             String?
  /// Phase 11, work unit 11A-2 (state machine itself lands in 11B-1):
  /// defaults to `"published"` so every one of the 40 pre-existing rows
  /// stays exactly as playable/streamable as it is today after this
  /// additive migration runs — none of them silently become a draft. New
  /// media uploaded through the 11B-3 admin API starts at `"draft"`
  /// instead, set explicitly by that endpoint rather than relying on this
  /// column default (which exists for backfill safety, not as the intended
  /// state for freshly created rows).
  lifecycleState                String  @default("published")
  /// Phase 11, work unit 11E-3: per-episode admin access-tier override.
  /// Nullable with NO default, so every one of the 40 pre-existing rows (and
  /// every caller that creates/updates a `Video` without specifying it, e.g.
  /// `seed.ts`, `AdminMediaService.createUpload`) keeps compiling and
  /// backfills to `null` — the additive migration for this column changes no
  /// existing row's value. `null` means "no override, use the default
  /// `episodeNumber >= FREE_EPISODE_LIMIT` rule" (see
  /// `EntitlementsService.resolveEpisodePremium`, which is the ONLY code path
  /// that reads this column); `"premium"`/`"free"` unconditionally decide the
  /// outcome regardless of `episodeNumber`. A plain string, not a Postgres
  /// enum, matching the existing `Video.category`/`Entitlement.tier`
  /// precedent — set/cleared only via the guarded
  /// `PATCH /admin/media/:id/access-tier` endpoint
  /// (`UpdateAccessTierDto` validates it to exactly `"free" | "premium" |
  /// null`). Deliberately NOT exposed on the public `VideoResponseDto` — see
  /// `AdminMediaDto` for its only intended external exposure.
  accessTierOverride            String?

  @@index([seriesId])
  @@index([sortOrder])
  @@index([lifecycleState])
}

// Phase 11, work unit 11E-4: additive series metadata. `id` intentionally
// has NO `@default` — it is the existing plain-string `seriesId` convention
// already used by `Video.seriesId` above (e.g. "series-104"), so a `Series`
// row is created with a client-provided id that ANNOTATES an existing
// grouping rather than generating a new one. There is deliberately NO
// relation/FK to `Video` here (`Video.seriesId` stays a plain, unconstrained
// `String`, matching its existing doc comment and the
// `UserVideoInteraction.videoId`/`WatchProgress.seriesId` precedent of
// keeping cross-entity references at the application level, not the DB
// level) — this table is purely optional metadata (display title, cover
// image, manual ordering) about a `seriesId` value that may or may not have
// any `Video` rows yet. Creating, updating, listing, or never creating a
// `Series` row has zero effect on `Video` rows or the public `/videos/feed`
// grouping (still computed client-side from `Video.seriesId`, unchanged by
// this work unit). `sortOrder` defaults to 0, independent of and unrelated
// to `Video.sortOrder` (a different table, a different ordering concern).
model Series {
  id            String   @id
  title         String
  coverImageKey String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  /// Phase 11, work unit 11F-1: safe (soft) archive — the PRIMARY "delete"
  /// action for a `Series` row. Nullable with NO default, so every
  /// pre-existing row (and every caller that creates/updates a `Series`
  /// without specifying it) keeps compiling and backfills to `null`
  /// ("active, not archived") — this additive migration changes no existing
  /// row's value. Non-null means "archived at this timestamp"; archiving
  /// and unarchiving only ever set/clear this column (no data loss, fully
  /// reversible) via `POST /admin/series/:id/archive`/`:id/unarchive`.
  /// `GET /admin/series` excludes archived rows by default and only
  /// includes them when `includeArchived=true` is explicitly passed. This
  /// is distinct from the guarded HARD `DELETE /admin/series/:id`, which
  /// actually removes the row and is refused (409) whenever the series
  /// still has published episodes.
  archivedAt    DateTime?

  @@index([sortOrder])
}

// Phase 9, work unit 9-B1: per-user Like/Save state for a video, mirroring
// mobile's local `VideoInteraction` shape (`video-interactions.tsx`) exactly
// so the sync layer added in 9-B2/mobile is a near-direct mapping. `videoId`
// is intentionally a plain string, NOT a `@relation` FK to `Video.id` —
// consistent with how `Video.seriesId` above is already a plain string with
// no relation, and it keeps referential-integrity enforcement (does this
// video exist?) as an explicit application-level check in the 9-B2 endpoint
// layer rather than a DB constraint. That is deliberate: a like/save action
// failing loudly with a DB-level foreign key violation is a worse failure
// mode for this MVP than the endpoint returning a clear
// `AppException`/404-style error after checking `Video` existence itself,
// and it avoids having to pick an `onDelete` cascade/restrict policy for
// `Video` deletion (no delete-video endpoint exists yet) as a side effect of
// this schema-only work unit.
model UserVideoInteraction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoId   String
  isLiked   Boolean  @default(false)
  isSaved   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([userId, videoId])
  @@index([userId])
}

// Phase 9, work unit 9-B1: per-user, per-series watch progress, mirroring
// mobile's local `SeriesProgress` shape (`series-progress.tsx`) exactly.
// `seriesId` and `lastWatchedVideoId` are plain strings for the same reason
// as `UserVideoInteraction.videoId` above (no DB-level FK to `Video`;
// existence is an application-level concern for the 9-B2 endpoint).
// `positionSeconds`/`durationSeconds` use `Int`/`Int?` for consistency with
// the existing `Video.durationSeconds Int?` convention in this schema
// (seconds-as-integer), even though mobile's local `SeriesProgress` type
// uses a plain `number` that would also fit a `Float`.
model WatchProgress {
  id                       String   @id @default(cuid())
  userId                   String
  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId                 String
  lastWatchedVideoId       String
  lastWatchedEpisodeNumber Int
  positionSeconds          Int
  durationSeconds          Int?
  updatedAt                DateTime @updatedAt

  @@unique([userId, seriesId])
  @@index([userId])
}

// Phase 10, work unit 10-B1: account-wide premium entitlement (single tier,
// not per-series/per-episode — matches how `FREE_EPISODE_LIMIT` already
// works client-side today; see DECISIONS.md "Phase 10 approved..." entry,
// default decision 5). `revokedAt` mirrors `Session.revokedAt`'s existing
// nullable-timestamp revocation pattern (soft-revoke, not delete, so history
// stays auditable) rather than introducing a new convention.
// `expiresAt`/`revokedAt` are independently nullable: `expiresAt IS NULL`
// means "no expiration," `revokedAt IS NULL` means "not revoked" — a row is
// currently active only when both are satisfied
// (`revokedAt IS NULL AND (expiresAt IS NULL OR expiresAt > now())`).
// `source`/`tier` are plain strings, not enums, matching `Video.category`'s
// existing precedent — no real payment source exists yet ("dev-grant" is the
// only value produced by this phase), and using a string avoids a schema
// migration when a real source is added later.
model Entitlement {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier      String
  grantedAt DateTime  @default(now())
  expiresAt DateTime?
  revokedAt DateTime?
  source    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
}

// Phase 11, work unit 11-B2: self-hosted analytics/crash-event ingestion
// (see DECISIONS.md "Phase 11 approved..." — default decisions 1/2/4).
// Unlike every other user-owned model in this schema (which cascade-delete
// with the User), `userId` here is nullable with ON DELETE SET NULL:
// deleting an account unlinks the user's identity from their events without
// destroying the aggregate data — the privacy-preserving middle ground
// recorded in DECISIONS.md. `properties` is validated against a per-event
// server-side allowlist in AnalyticsService before ever reaching this
// table; nothing outside that allowlist is persisted.
model AnalyticsEvent {
  id              String   @id @default(cuid())
  userId          String?
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  eventName       String
  properties      Json
  platform        String
  clientTimestamp DateTime
  receivedAt      DateTime @default(now())

  @@index([eventName])
  @@index([userId])
  @@index([receivedAt])
}
